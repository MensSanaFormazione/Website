---
import '../styles/global.css';
import { LINKEDIN_URL, INSTAGRAM_URL } from '../data/corsi.js';

interface Props {
  title: string;
  description: string;
  /* Immagine per le anteprime dei link (LinkedIn, WhatsApp, Facebook).
     Percorso relativo alla radice del sito: viene reso assoluto qui sotto,
     perche' i social NON accettano percorsi relativi. */
  image?: string;
}
const { title, description, image = '/og-default.png' } = Astro.props;

/* ⛔ Indirizzo canonico. Oggi apex e www rispondono TUTTI E DUE 200 senza
   rimando, quindi per Google sono due siti gemelli: il canonico dice quale
   dei due vale. Il dominio di riferimento e' quello in astro.config.mjs. */
const canonico = new URL(Astro.url.pathname, Astro.site).href;
const ogImmagine = new URL(image, Astro.site).href;
/* ⛔ "Contatti" e' stato tolto dalla barra il 25/08: portava esattamente
   dove porta il pulsante "Parliamone", quindi erano due voci per la stessa
   pagina e l'occhio doveva scegliere fra due cose identiche. Il collegamento
   resta nel piede, dove si cercano i recapiti.
   ⛔ Il 25/08 e' uscita anche "Su misura": non e' un ramo a se', e' un modo di
   erogare i corsi, quindi sta dentro "Corsi". La pagina NON e' orfana, ci si
   arriva da sei punti (i due inviti della home, la fascia in fondo al
   catalogo, la fascia di ogni pagina area, il piede). */
const nav = [
  { href: '/', label: 'Home' },
  /* ⛔ 25/08, segnalato da Nicola: su `/su-misura/` NESSUNA voce risultava
     accesa, perche' la voce si accendeva solo con un confronto esatto fra
     l'indirizzo e il suo `href`. Chi entrava li' non capiva piu' dov'era.
     ⛔ E il difetto era piu' largo di cosi': valeva anche per le OTTO pagine
     area (`/formazione/compliance/` e le altre) e per le 22 schede corso
     (`/corsi/...`), cioe' per 30 pagine su 38.
     Adesso la voce si accende per RAMO: "Corsi" copre il catalogo, le aree,
     le schede e il su misura, che sono tutti modi di comprare la stessa cosa.
     ⛔ "Home" resta sul confronto esatto di proposito: con `startsWith` la
     barra "/" combacerebbe con qualunque pagina del sito. */
  {
    href: '/formazione/',
    label: 'Corsi',
    rami: ['/formazione/', '/su-misura/', '/corsi/'],
  },
];
/* ⛔ Normalizzato con la barra finale: se qualcuno arriva su `/su-misura`
   senza barra, il confronto deve funzionare lo stesso. */
const percorso = Astro.url.pathname;
const current = percorso.endsWith('/') ? percorso : `${percorso}/`;
const eAttiva = (item) =>
  item.rami ? item.rami.some((r) => current.startsWith(r)) : current === item.href;
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/fraunces-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="canonical" href={canonico} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonico} />
    <meta property="og:site_name" content="Mens Sana Formazione" />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:image" content={ogImmagine} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Mens Sana Formazione, corsi Legal e Compliance per enti e imprese" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImmagine} />
  </head>
  <body>
    <script is:inline>
      /* ⛔ Marca la pagina come "con JavaScript" PRIMA che venga disegnata.
         Serve a tenere nascoste solo le cose che poi un'animazione mostra: se
         lo script non gira, quelle cose restano visibili invece di sparire.
         Stesso difetto gia' visto sui siti dei locali (ZAV, Selva Urbana). */
      document.documentElement.classList.add('con-js');
    </script>
    <div class="scroll-progress" id="scroll-progress" aria-hidden="true"></div>
    <header class="site-header" id="site-header">
      <div class="container site-header__inner">
        <a href="/" class="site-header__brand" aria-label="Mens Sana Formazione, home">
          <!-- ⛔ 25/08: le misure dichiarate servono a non far ballare la pagina
               mentre il logo si carica, e vanno tenute in proporzione al file.
               Il file e' stato RITAGLIATO oggi (vedi sotto), quindi il
               rapporto e' cambiato da 1043x300 a 648x298. -->
          <img src="/logo.png" alt="Mens Sana Formazione" width="122" height="56" />
        </a>
        <nav class="site-nav" id="site-nav" aria-label="Navigazione principale">
          {nav.map((item) => (
            <a
              href={item.href}
              class:list={['site-nav__link', { 'is-active': eAttiva(item) }]}
              aria-current={eAttiva(item) ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))}
          <div class="site-nav__social">
            <a
              href={LINKEDIN_URL}
              target="_blank"
              rel="noopener"
              class="site-nav__linkedin"
              aria-label="Seguici su LinkedIn"
            >
              <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.55C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.72C24 .77 23.2 0 22.22 0z"/></svg>
            </a>
            {INSTAGRAM_URL && (
              <a
                href={INSTAGRAM_URL}
                target="_blank"
                rel="noopener"
                class="site-nav__instagram"
                aria-label="Seguici su Instagram"
              >
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><path d="M17.5 6.5h.01"/></svg>
              </a>
            )}
          </div>
        </nav>
        <!-- ⛔ 25/08: il pulsante stava DENTRO il menu, quindi sul telefono
             spariva nell'hamburger e l'unica azione di conversione del sito
             non era raggiungibile senza aprire il menu. Ora sta fuori, accanto
             all'hamburger: su schermo grande resta esattamente dov'era. -->
        <div class="site-header__azioni">
          <a href="/contatti/" class="btn btn--primary site-nav__cta">Parliamone</a>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container site-footer__grid">
        <div>
          <img src="/logo.png" alt="Mens Sana Formazione" width="165" height="76" class="site-footer__logo" />
          <p>
            Formazione Legal &amp; Compliance per enti, imprese e professionisti.
            Corsi in videolezione e percorsi costruiti su misura, dal 2017 a
            Milano.
          </p>
        </div>
        <div>
          <h3>Contatti</h3>
          <ul>
            <li>Via San Francesco d'Assisi, 13, 20122 Milano</li>
            <li><a href="tel:+390281558505">(+39) 02 8155 8505</a></li>
            <li><a href="tel:+393519013820">(+39) 351 901 3820</a></li>
            <li><a href="mailto:info@mensanaformazione.com">info@mensanaformazione.com</a></li>
            <li>PEC: info@pec.mensanaformazione.com</li>
          </ul>
          <div class="site-footer__social">
            <a href={LINKEDIN_URL} target="_blank" rel="noopener" class="site-footer__linkedin">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.55C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.72C24 .77 23.2 0 22.22 0z"/></svg>
              Seguici su LinkedIn
            </a>
            {INSTAGRAM_URL && (
              <a
                href={INSTAGRAM_URL}
                target="_blank"
                rel="noopener"
                class="site-footer__tondo"
                aria-label="Seguici su Instagram"
              >
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><path d="M17.5 6.5h.01"/></svg>
              </a>
            )}
          </div>
        </div>
        <div>
          <h3>Orari</h3>
          <ul>
            <li>Lun-Ven: 9:00-18:00</li>
            <li>Sabato: 9:00-12:00</li>
          </ul>
          <h3>Esplora</h3>
          <ul>
            <li><a href="/formazione/">Corsi a catalogo</a></li>
            <li><a href="/su-misura/">Corsi su misura</a></li>
            <li><a href="/digital/">Mens Sana Digital</a></li>
            <li><a href="/contatti/">Contatti</a></li>
            <li><a href="/privacy/">Informativa Privacy e Cookie</a></li>
            <li><a href="/termini/">Condizioni generali di contratto</a></li>
          </ul>
        </div>
      </div>
      <div class="container site-footer__legal">
        <p>© {new Date().getFullYear()} Mens Sana Formazione S.r.l. · Via San Francesco d'Assisi 13, 20122 Milano · C.F. e P.IVA 10160940960 · Iscritta al Registro delle Imprese di Milano · <a href="/privacy/">Privacy &amp; Cookie</a> · <a href="/termini/">Condizioni generali</a></p>
      </div>
    </footer>

    <script>
      /* ⛔ 25/08: qui c'era lo script che apriva e chiudeva il menu del
         telefono. Tolto insieme all'hamburger: con due sole voci in tutto il
         sito, il menu a tendina non c'era motivo di esistere. Vedi il CSS
         della barra piu' sotto. */

      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          }
        },
        /* ⛔ 25/08: era `threshold: 0.12`, cioe' l'elemento cominciava a
           comparire solo quando era GIA' entrato nello schermo per un ottavo.
           Chi scorre in fretta lo superava prima che la dissolvenza finisse e
           trovava blocchi vuoti: sul vivo ho fotografato la fascia scura "Il
           metodo" come rettangolo nero senza una parola dentro. Adesso parte
           240 px PRIMA che l'elemento entri, quindi quando arriva sotto gli
           occhi ha gia' finito. Il movimento resta, i buchi no. */
        { threshold: 0, rootMargin: '240px 0px 240px 0px' }
      );
      const daMostrare = document.querySelectorAll('.reveal');
      daMostrare.forEach((el) => observer.observe(el));

      /* ⛔ Rete di sicurezza. Dentro un iframe (le anteprime dei link) Chrome
         non emette eventi di scorrimento e l'osservatore non scatta mai:
         senza questa riga l'anteprima del sito esce vuota. Otto secondi, non
         tre: a tre si accende tutto prima che il lettore ci arrivi. */
      /* ⛔ 25/08: la rete accendeva solo gli elementi `.reveal`, ma le entrate
         dell'apertura (`.rise` e le otto righe della pila) sono animazioni CSS
         separate, e dentro un iframe non dipinto NON arrivano mai a
         destinazione: restavano a zero per sempre. Ora la rete alza anche
         quelle, con una classe sola su `html`. */
      const mostraTutto = () => {
        daMostrare.forEach((el) => el.classList.add('is-visible'));
        document.documentElement.classList.add('entrate-finite');
      };
      if (window.self !== window.top) mostraTutto();
      else setTimeout(mostraTutto, 8000);

      // Barra di avanzamento + header compatto durante lo scroll
      const bar = document.getElementById('scroll-progress');
      const header = document.getElementById('site-header');
      const onScroll = () => {
        const testata = document.getElementById('site-header');
        if (testata) testata.classList.toggle('is-scesa', window.scrollY > 8);
        const max = document.documentElement.scrollHeight - window.innerHeight;
        if (bar) bar.style.transform = `scaleX(${max > 0 ? window.scrollY / max : 0})`;
        header?.classList.toggle('is-scrolled', window.scrollY > 40);
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      // Spotlight: il bagliore segue il mouse sulle card .spot
      document.querySelectorAll('.spot').forEach((el) => {
        el.addEventListener('pointermove', (e) => {
          const r = el.getBoundingClientRect();
          (el as HTMLElement).style.setProperty('--mx', `${e.clientX - r.left}px`);
          (el as HTMLElement).style.setProperty('--my', `${e.clientY - r.top}px`);
        });
      });

      /* ⛔ 25/08: qui c'era il conteggio animato da zero, e con lui una riga
         che riempiva i numeri via script. Tolti tutti e due. Due motivi, non
         uno. Il primo: per 1,3 secondi la home dichiarava numeri VERI E
         SBAGLIATI ("1 corso a catalogo", "0 aree tematiche"), e chi guarda
         non sa che stanno salendo; su 22 si puo' discutere, su 8 e su 9 il
         conteggio non aggiunge niente e la cifra intermedia e' credibile.
         Il secondo, il metro di Nicola: una cosa fatta perche' ce l'hanno
         tutti si toglie, e il contatore che sale ce l'hanno tutti.
         I numeri ora stanno scritti nell'HTML, quindi si leggono anche senza
         JavaScript, e compaiono con la stessa dissolvenza del resto
         dell'apertura. ⛔ L'animazione, se un giorno si rivuole, sta nella
         cronologia di questo file. */
    </script>

    <style>
      .site-header {
        position: sticky;
        top: 0;
        z-index: 50;
        /* Carta velata, non bianco: sopra un'apertura color carta un pannello
           bianco si vede come una fascia estranea. */
        background: rgba(250, 247, 243, 0.88);
        backdrop-filter: blur(14px) saturate(1.1);
        -webkit-backdrop-filter: blur(14px) saturate(1.1);
        border-bottom: 1px solid transparent;
        transition: border-color var(--transition), box-shadow var(--transition);
      }
      /* Il bordo compare solo quando la pagina e' stata scorsa: fermi in cima
         la barra non deve sembrare staccata dall'apertura.
         ⛔ 25/08, difetto piu' visibile del sito guardandolo sul vivo: con la
         carta all'88% il CONTENUTO DELLA PAGINA TRASPARIVA dietro il menu
         mentre si scorreva (in una schermata si legge "Digitalizzazione PA"
         sotto le voci della barra). Il vetro smerigliato ha senso solo se
         nasconde: fermi in cima non c'e' niente da nascondere e la barra resta
         velata, appena si scorre diventa PIENA. La leggibilita' del menu vale
         piu' dell'effetto. */
      .site-header.is-scesa {
        background-color: var(--carta);
        border-bottom-color: var(--grigio-100);
        box-shadow: var(--shadow-sm);
      }
      .site-header__inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding-block: 0.8rem;
        transition: padding var(--transition);
      }
      .site-header__brand img {
        /* ⛔ 25/08: da 44 a 64 px in due passaggi su richiesta di Nicola, poi
           RIPORTATO A 56. Guardando la prima schermata da fuori, a 64 px il
           marchio era il secondo elemento piu' grande della pagina dopo il
           titolo, e un marchio grande non da' autorevolezza, la toglie: chi
           deve convincere mette avanti quello che sa fare, non il proprio
           nome. 56 e' un compromesso, non un ritorno a 44: se Nicola lo
           rivuole a 64 e' un numero. */
        height: 56px;
        width: auto;
        transition: height var(--transition);
      }
      .site-header.is-scrolled { box-shadow: var(--shadow-md); }
      .site-header.is-scrolled .site-header__inner { padding-block: 0.45rem; }
      .site-header.is-scrolled .site-header__brand img { height: 42px; }

      .site-nav {
        display: flex;
        align-items: center;
        gap: 1.6rem;
        /* Con il pulsante uscito dal menu la barra ha tre blocchi: il marchio
           a sinistra, e menu piu' pulsante appaiati a destra. */
        margin-left: auto;
      }
      .site-header__azioni {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        margin-left: 1.6rem;
      }
      .site-nav__link {
        font-size: var(--fs-300);
        font-weight: 600;
        color: var(--grigio-700);
        transition: color var(--transition);
        position: relative;
        padding-block: 0.3rem;
      }
      .site-nav__link::after {
        content: '';
        position: absolute;
        left: 0;
        bottom: 0;
        width: 100%;
        height: 2px;
        background: var(--rosso);
        border-radius: 2px;
        transform: scaleX(0);
        transform-origin: left;
        transition: transform var(--transition);
      }
      .site-nav__link:hover { color: var(--nero); }
      .site-nav__link:hover::after,
      .site-nav__link.is-active::after { transform: scaleX(1); }
      .site-nav__link.is-active { color: var(--nero); }

      .site-nav__linkedin {
        display: grid;
        place-items: center;
        width: 2.3rem;
        height: 2.3rem;
        border-radius: 50%;
        color: var(--grigio-700);
        background: var(--grigio-100);
        transition: background var(--transition), color var(--transition), transform var(--transition);
      }
      .site-nav__linkedin:hover {
        background: #0a66c2;
        color: var(--bianco);
        transform: translateY(-2px);
      }

      .site-nav__instagram {
        display: grid;
        place-items: center;
        width: 2.3rem;
        height: 2.3rem;
        border-radius: 50%;
        color: var(--grigio-700);
        background: var(--grigio-100);
        margin-left: -0.9rem;
        transition: background var(--transition), color var(--transition), transform var(--transition);
      }
      .site-nav__instagram:hover {
        background: linear-gradient(45deg, #f09433, #dc2743 45%, #bc1888);
        color: var(--bianco);
        transform: translateY(-2px);
      }

      /* Su desktop il contenitore è trasparente: le icone restano figlie di
         .site-nav e la barra resta identica a prima. Su mobile (sotto)
         diventa una riga sola, invece di barre grigie impilate. */
      .site-nav__social {
        display: contents;
      }

      /* ⛔ 25/08, deciso da Nicola guardandolo sul telefono: l'hamburger e il
         suo pannello sono STATI TOLTI, non riparati.
         La diagnosi vera non era il pannello brutto: era un menu costruito per
         un sito con otto voci, montato su un sito che ne ha DUE. Da li'
         venivano tutti i sintomi, cioe' un riquadro che copriva mezzo schermo
         per dire "Home" e "Corsi", il bianco pieno che staccava dalla carta
         come un foglio incollato, e il pannello che finiva a meta' lasciando
         intravedere la pagina sotto.
         Adesso in barra ci sono le sole due cose che servono davvero:
         "Corsi" e "Parliamone". ⛔ "Home" non si mostra perche' quel lavoro
         lo fa gia' il marchio a sinistra, che e' un collegamento alla home in
         ogni pagina; e le due icone social escono dalla barra perche' nel
         piede ci sono gia'. Zero pannelli, zero tocchi in piu', zero stato
         aperto/chiuso da gestire. */
      @media (max-width: 820px) {
        .site-nav {
          gap: 0.9rem;
          margin-left: auto;
        }
        .site-nav__link { font-size: var(--fs-300); }
        .site-nav__social { display: none; }
        /* Il marchio e' gia' il collegamento alla home. */
        .site-nav__link[href="/"] { display: none; }

        .site-header__azioni { margin-left: 0.9rem; gap: 0; }
        .site-nav__cta {
          padding: 0.6rem 1.05rem;
          font-size: var(--fs-200);
          white-space: nowrap;
        }
        .site-header__brand img { height: 42px; }
        .site-header.is-scrolled .site-header__brand img { height: 38px; }
      }

      /* ⛔ Sotto i 400 px i tre elementi non ci stavano piu' in una riga:
         misurato, a 360 px straripava. Il marchio scende, e il margine fra
         "Corsi" e il pulsante si stringe. */
      @media (max-width: 25rem) {
        .site-header__brand img,
        .site-header.is-scrolled .site-header__brand img { height: 36px; }
        .site-nav { gap: 0.6rem; }
        .site-header__azioni { margin-left: 0.6rem; }
        .site-nav__cta { padding: 0.55rem 0.85rem; }
      }

      /* ⛔ Il passaggio al piede era un taglio secco da carta a quasi nero.
         Adesso e' una cucitura voluta: filetto rosso del marchio, e sotto una
         sfumatura corta che entra nel nero invece di sbatterci contro. */
      .site-footer {
        /* ⛔ Il colore pieno sotto la sfumatura non e' ridondante: se la
           sfumatura non viene disegnata, il testo chiaro resterebbe su fondo
           chiaro. Trovato misurando i contrasti, dove il piede risultava a
           1,59 su 4,5 proprio perche' il fondo dichiarato era trasparente. */
        background-color: var(--nero);
        background-image: linear-gradient(180deg, var(--grigio-900), var(--nero) 14rem);
        color: var(--grigio-300);
        padding-block: clamp(3rem, 6vw, 4.5rem) 0;
        font-size: var(--fs-300);
        border-top: 3px solid var(--rosso);
      }
      .site-footer a:not(.btn) { color: var(--grigio-300); }
      .site-footer a:not(.btn):hover { color: var(--rosso-chiaro); }
      .site-footer__grid {
        display: grid;
        gap: 2.5rem;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
        padding-bottom: 2.5rem;
      }
      .site-footer__logo {
        /* Nel piede lo spazio c'e' davvero: da 40 a 76 px. */
        height: 76px;
        width: auto;
        margin-bottom: 1.2rem;
        filter: brightness(0) invert(1);
      }
      .site-footer h3 {
        color: var(--bianco);
        font-size: var(--fs-300);
        text-transform: uppercase;
        letter-spacing: 0.1em;
        margin-bottom: 0.8rem;
      }
      .site-footer h3 + ul + h3 { margin-top: 1.5rem; }
      .site-footer ul { list-style: none; }
      .site-footer li { margin-bottom: 0.45rem; }
      .site-footer a { color: var(--grigio-300); transition: color var(--transition); }
      .site-footer a:hover { color: var(--bianco); }
      .site-footer__social {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.6rem;
        margin-top: 1rem;
      }
      /* ⛔ 25/08, decisione che era rimasta ferma: i due pulsanti social del
         piede erano blu LinkedIn e sfumatura rosa Instagram, gli UNICI due
         colori freddi rimasti dopo che la palette e' stata rifatta calda.
         Nel piede si cercano dei recapiti, non si entra in una piattaforma:
         qui i due pulsanti sono neutri come tutto il resto, e diventano rossi
         al passaggio del puntatore. ⛔ Il blu resta invece nella mattonella
         del riquadro LinkedIn della home, dove SERVE: quello e' un invito ad
         andare su LinkedIn e il quadrato azzurro e' il segno con cui la
         piattaforma si riconosce a colpo d'occhio. Due trattamenti diversi
         perche' fanno due lavori diversi. */
      .site-footer__tondo {
        display: grid;
        place-items: center;
        width: 2.4rem;
        height: 2.4rem;
        border-radius: 50%;
        color: var(--grigio-300) !important;
        background: transparent;
        border: 1.5px solid var(--grigio-700);
        transition: transform var(--transition), background var(--transition),
          border-color var(--transition), color var(--transition);
      }
      .site-footer__tondo:hover {
        transform: translateY(-2px);
        background: var(--rosso);
        border-color: var(--rosso);
        color: var(--bianco) !important;
      }
      .site-footer__linkedin {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-weight: 700;
        color: var(--grigio-300) !important;
        background: transparent;
        border: 1.5px solid var(--grigio-700);
        padding: 0.5rem 1rem;
        border-radius: 999px;
        transition: transform var(--transition), background var(--transition),
          border-color var(--transition), color var(--transition);
      }
      .site-footer__linkedin:hover {
        transform: translateY(-2px);
        background: var(--rosso);
        border-color: var(--rosso);
        color: var(--bianco) !important;
      }
      .site-footer__legal {
        border-top: 1px solid var(--grigio-900);
        padding-block: 1.25rem;
        /* ⛔ Era grigio-500 e sul fondo scuro stava a 3,30 su 4,5: misurato,
           non stimato. La riga dei dati societari deve essere leggibile. */
        color: var(--grigio-300);
        /* ⛔ 25/08: andava a capo lasciando "Condizioni generali" da sola.
           Il corpo scende quel tanto che basta perche' su schermo da computer
           stia tutta su una riga; sotto i 1100 px torna a capo, ed e' giusto
           cosi', su un telefono una riga sola sarebbe illeggibile. */
        font-size: 0.72rem;
        letter-spacing: -0.005em;
      }
      @media (min-width: 90rem) {
        .site-footer__legal { font-size: var(--fs-200); }
      }
    </style>
  </body>
</html>
