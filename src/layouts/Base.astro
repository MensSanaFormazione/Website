---
interface Props { title: string; description: string; image?: string; }
const { title, description, image = '/og-default.png' } = Astro.props;
const path = Astro.url.pathname;
const coursesActive = ['/formazione/', '/corsi/', '/su-misura/'].some(p => path.startsWith(p));
const canonical = new URL(path, Astro.site).href;
const preview = import.meta.env.MSF_PREVIEW === '1';
---
<!doctype html>
<html lang="it"><head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
<title>{title}</title><meta name="description" content={description} />
{(preview || path.startsWith("/esito/") || path === "/404.html") && <meta name="robots" content="noindex,nofollow" />}
<link rel="canonical" href={canonical} /><meta name="theme-color" content="#f7f6f2" />
<meta property="og:title" content={title} /><meta property="og:description" content={description} />
<meta property="og:type" content="website" /><meta property="og:url" content={canonical} />
<meta property="og:image" content={new URL(image, Astro.site).href} /><meta property="og:locale" content="it_IT" />
<meta name="twitter:card" content="summary_large_image" />
<link rel="icon" href="/favicon.png" />
<link rel="preload" href="/assets/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/assets/fraunces-latin.woff2" as="font" type="font/woff2" crossorigin />
<link rel="stylesheet" href="/style.css" />
<link rel="stylesheet" href="/depth.css" />
<link rel="stylesheet" href="/details.css" />
<link rel="stylesheet" href="/design-system.css" />
<link rel="stylesheet" href="/pages.css" />
<link rel="stylesheet" href="/complete.css" />
<script is:inline src="/script.js" defer></script>
<script is:inline src="/depth.js" defer></script>
<script is:inline src="/details.js" defer></script>
<script is:inline src="/forms.js" defer></script>
</head><body>

  <a class="skip-link" href="#contenuto">Vai al contenuto</a>
  <svg class="svg-defs" aria-hidden="true"><defs><symbol id="arrow" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></symbol><symbol id="diagonal" viewBox="0 0 24 24"><path d="M6 18 18 6M6 6h12v12"/></symbol></defs></svg>
  <header class="header">
    <div class="wrap header-inner">
      <a class="brand" href="/" aria-label="Mens Sana Formazione, homepage"><img src="/assets/logo.png" alt="Mens Sana Formazione" width="1043" height="300"></a>
      <nav class="navigation" aria-label="Navigazione principale">
        <a href="/" aria-current={path === "/" ? "page" : undefined}>Home</a>
        <a href="/formazione/" aria-current={coursesActive ? "page" : undefined}>Corsi</a>
        <a href="/consulenza/" aria-current={path === "/consulenza/" ? "page" : undefined}>Consulenza</a>
      </nav>
      <div class="header-social" aria-label="Pagine social">
        <a class="social-link social-linkedin" href="https://www.linkedin.com/company/mens-sana-formazione-srl/" target="_blank" rel="noopener noreferrer" aria-label="Mens Sana Formazione su LinkedIn (nuova scheda)"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" stroke="none" d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.55C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.72C24 .77 23.2 0 22.22 0z"/></svg></a>
        <a class="social-link social-instagram" href="https://www.instagram.com/mensanaformazione/" target="_blank" rel="noopener noreferrer" aria-label="Mens Sana Formazione su Instagram (nuova scheda)"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><path d="M17.5 6.5h.01"/></svg></a>
      </div>
      <a href="/contatti/" class="button button-dark header-cta" aria-current={path === "/contatti/" ? "page" : undefined}>Parliamone <svg aria-hidden="true" class="icon"><use href="#diagonal"/></svg></a>
    </div>
  </header>
  <main id="contenuto"><slot /></main>
  <footer class="footer">
    <div class="wrap">
      <div class="footer-main"><div class="footer-brand"><a href="/" aria-label="Mens Sana Formazione, homepage"><img src="/assets/logo.png" alt="Mens Sana Formazione" width="1043" height="300" loading="lazy"></a><p>Formazione Legal &amp; Compliance<br>per enti, imprese e professionisti.<br>Milano, dal 2017.</p></div><div><h2>Esplora</h2><a href="/formazione/">Formazione</a><a href="/su-misura/">Corsi su misura</a><a href="/consulenza/">Consulenza</a><a href="/lavora-con-noi/">Lavora con noi</a></div><div><h2>Contatti</h2><a href="tel:+390281558505">(+39) 02 8155 8505</a><a href="tel:+393519013820">(+39) 351 901 3820</a><a href="/contatti/">Parliamone</a><a href="mailto:info@mensanaformazione.com">info@mensanaformazione.com</a><a href="mailto:info@pec.mensanaformazione.com">PEC: info@pec.mensanaformazione.com</a><p>Lun-Ven 9:00-18:00<br>Sabato 9:00-12:00</p></div><div><h2>Seguici</h2><a href="https://www.linkedin.com/company/mens-sana-formazione-srl/" class="linkedin-link">LinkedIn <svg aria-hidden="true" class="icon"><use href="#diagonal"/></svg></a><a href="https://www.instagram.com/mensanaformazione/">Instagram <svg aria-hidden="true" class="icon"><use href="#diagonal"/></svg></a></div></div>
      <div class="footer-legal"><p>© {new Date().getFullYear()} Mens Sana Formazione S.r.l. · C.F. e P.IVA 10160940960<br>Via San Francesco d’Assisi 13, 20122 Milano · Iscrizione al Registro delle Imprese di Milano</p><div><a href="/privacy/">Privacy e cookie</a><a href="/termini/">Condizioni generali</a></div></div>
    </div>
  </footer>
</body></html>
