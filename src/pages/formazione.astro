---
import fs from 'node:fs';
import path from 'node:path';
import Base from '../layouts/Base.astro';
import Freccia from '../components/Freccia.astro';
import { aree, areeSuRichiesta, mostraPrezzo, prezziAttivi, numeroCorsi, corsiInLettere, areeInLettere } from '../data/corsi.js';

const fmtPrezzo = (n) => String(n).replace(/\B(?=(\d{3})+(?!\d))/g, '.');
const conCorsi = aree.filter((a) => a.corsi.length > 0);
const nCorsi = conCorsi.reduce((n, a) => n + a.corsi.length, 0);

/* Ogni area mostra la sua grafica appena il file compare in `public/aree/`.
   Finche' non c'e' si vede la lettera: niente immagini rotte.
   ⛔ Il percorso parte da `process.cwd()`, NON da `import.meta.url`: in build
   Astro compila la pagina in `dist/.prerender/chunks/`, quindi un percorso
   relativo al modulo finisce a cercare in `dist/public/` e non trova mai
   niente. Sbagliato in silenzio: le immagini c'erano e restava il segnaposto. */
const haImmagine = (slug) =>
  fs.existsSync(path.join(process.cwd(), 'public', 'aree', `${slug}.webp`));
---

<Base
  title="Catalogo corsi Legal & Compliance | Mens Sana Formazione"
  description={`${numeroCorsi} corsi in ${areeInLettere} aree: diritto societario, organismi di controllo, contrattualistica, credit management, finance e fiscale, compliance, business coaching, digitalizzazione PA, intelligenza artificiale.`}
>
  {/* ⛔ Qui c'erano DUE introduzioni in fila, ognuna con il suo titolone in
       serif e il suo paragrafo grigio: "Ventidue corsi in otto aree" e subito
       dopo "Da dove vuoi partire?". Si leggevano due volte le stesse cose
       prima di vedere un corso. Fuse in una sola il 25/08, su segnalazione di
       Nicola: titolo, una riga, e subito le aree. */}
  <section class="section catalogo-apertura" id="aree">
    <div class="container">
      <div class="catalogo-testa catalogo-testa--riga">
        <p class="eyebrow">Il catalogo</p>
        <h1>{corsiInLettere.charAt(0).toUpperCase() + corsiInLettere.slice(1)} corsi<br />in {areeInLettere} aree</h1>
        <p class="catalogo-testa__sub">
          Ogni area è un mestiere diverso: apri quella che ti riguarda e trovi
          solo i suoi corsi. Ognuno può diventare un'edizione aziendale
          costruita sulle vostre esigenze.
        </p>
      </div>

      <div class="aree-griglia">
        {conCorsi.map((area, i) => (
          <a
            href={`/formazione/${area.slug}/`}
            class="area-card reveal spot"
            style={`--d: ${i * 0.06}s`}
          >
            <div class="area-card__figura">
              {haImmagine(area.slug) ? (
                <img src={`/aree/${area.slug}.webp`} alt="" width="640" height="480" loading="lazy" />
              ) : (
                <div class="area-card__segno" aria-hidden="true">{area.sigla}</div>
              )}
            </div>
            <div class="area-card__testo">
              <p class="area-card__eti">
                Area {area.sigla}
                <span>{area.corsi.length} {area.corsi.length === 1 ? 'corso' : 'corsi'}</span>
              </p>
              <h3>{area.nome}</h3>
              <p class="area-card__occhiello">{area.occhiello}</p>
              <span class="area-card__cta">Vedi i corsi <Freccia /></span>
            </div>
          </a>
        ))}
      </div>

      {areeSuRichiesta.length > 0 && (
        <div class="su-richiesta reveal">
          <h3>Altre aree su richiesta</h3>
          <p>
            Progettiamo percorsi dedicati anche in queste aree: contattaci per
            un programma su misura.
          </p>
          <ul>
            {areeSuRichiesta.map((a) => (
              <li><strong>{a.sigla}</strong> {a.nome}</li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </section>

  {/* INDICE COMPLETO */}
  <section class="section section--tinted indice-fascia" id="catalogo">
    <div class="container">
      {/* ⛔ L'indice e' chiuso all'arrivo: con 22 corsi, aperto occupava piu'
           schermate e spingeva in fondo tutto il resto. '<details>' e' nativo,
           quindi funziona anche senza JavaScript. */}
      <details class="indice-tutto reveal">
        <summary>
          <span class="indice-tutto__testo">
            <span class="indice-tutto__eti">Indice</span>
            <span class="indice-tutto__titolo">Tutti i {nCorsi} corsi, in una pagina sola</span>
          </span>
          <span class="indice-tutto__stato"><Freccia /></span>
        </summary>

        {/* ⛔ 01/09: la nota diceva "Prezzi IVA esclusa, riferiti al singolo
             partecipante" anche a prezzi spenti, cioe' annunciava una colonna
             che non c'era piu'. Adesso segue l'interruttore. */}
        <p class="indice-tutto__nota">
          {prezziAttivi ? (
            'Prezzi IVA esclusa, riferiti al singolo partecipante. Le edizioni aziendali si valutano caso per caso.'
          ) : (
            "Le quote non sono esposte: ogni richiesta si valuta caso per caso, sul numero di partecipanti e sul formato. Scriveteci e ricevete una proposta scritta."
          )}
        </p>

      {conCorsi.map((area) => (
        <div class:list={['indice', { 'indice--senza-prezzo': !prezziAttivi }]}>
          <h3 class="indice__area">
            <a href={`/formazione/${area.slug}/`}>
              <span class="indice__sigla">{area.sigla}</span>{area.nome}
            </a>
          </h3>
          <ul>
            {area.corsi.map((corso) => (
              <li>
                <a href={`/corsi/${corso.slug}/`}>
                  <span class="indice__cod">{corso.cod}</span>
                  <span class="indice__titolo">{corso.titolo}</span>
                  <span class="indice__durata">{corso.durataVideo}</span>
                  {/* ⛔ 01/09: a prezzi spenti la colonna ripeteva "Su
                       richiesta" ventidue volte di fila, cioe' una colonna
                       intera che non distingue niente. La riga adesso resta a
                       tre colonne e la cosa si dice una volta sola, nella nota
                       qui sopra. */}
                  {mostraPrezzo(corso) && (
                    <span class="indice__prezzo">{`${fmtPrezzo(corso.prezzo)} €`}</span>
                  )}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
      </details>
    </div>
  </section>

  {/* SU MISURA
       ⛔ 01/09: l'ancora si chiamava `id="consulenza"` ma la sezione parla
       di corsi su misura, ed e' un residuo del vecchio sito. Dal 01/09 la
       consulenza e' una pagina vera (`/consulenza/`): due cose diverse non
       possono avere lo stesso nome, o il primo che cerca l'una trova l'altra. */}
  <section class="section section--dark" id="su-misura">
    <div class="container">
      <div class="section-head section-head--riga reveal">
        <p class="eyebrow">Su misura</p>
        <h2>Nessuno di questi corsi è quello che vi serve?</h2>
        <p>
          Il catalogo è il punto di partenza. Durata, taglio, casi pratici e
          formato si costruiscono sulla vostra organizzazione, e se il tema non
          è in elenco si progetta da zero.
        </p>
      </div>
      <a href="/su-misura/" class="btn btn--light">Come funziona un corso su misura</a>
    </div>
  </section>

  {/* ⛔ Qui c'era una seconda chiamata all'azione, "Un corso per la tua
       squadra?" con il pulsante "Richiedi una proposta". Tolta il 25/08 su
       richiesta di Nicola: arrivava subito dopo il blocco scuro "Su misura",
       che finisce gia' con un pulsante, quindi erano due inviti in fila e il
       secondo indeboliva il primo. Il testo, se dovesse servire, sta nel log
       della sessione. */}
</Base>

<style>
  .catalogo-apertura {
    padding-top: clamp(2.5rem, 6vw, 4rem);
    /* ⛔ Sopra la fascia dell'indice c'erano 104 px e sotto 48: lo stesso
       valore della fascia scura che segue, cosi' l'indice ha la stessa aria
       da tutte e quattro le parti. */
    padding-bottom: clamp(2rem, 4vw, 3rem);
  }
  /* La fascia dell'indice contiene una riga sola quando e' chiusa: con lo
     spazio pieno delle altre sezioni sembrava mezza vuota. */
  .indice-fascia { padding-block: clamp(2rem, 4vw, 3rem); }
  /* ⛔ 25/08, deciso da Nicola guardandolo sul telefono: l'indice dei 22 corsi
     NON si mostra sotto i 48rem. Ogni riga e' fatta di quattro colonne
     (codice, titolo, durata, prezzo) e su uno schermo stretto non e' piu' una
     tabella, e' una poltiglia di righe che vanno a capo dove capita.
     ⛔ Nessuna pagina resta orfana e non si perde nessun dato: le schede dei
     i corsi sono raggiungibili dalle pagine area qui sopra, e i prezzi
     stanno su ogni scheda. I collegamenti restano comunque nell'HTML, quindi
     i motori di ricerca li vedono lo stesso.
     ⚠️ Se un giorno lo si rivuole sul telefono, la strada NON e' rimetterlo
     com'e': e' rifare la riga come due righe, codice piu' titolo sopra e
     durata piu' prezzo sotto. */
  @media (max-width: 47.99rem) {
    .indice-fascia { display: none; }
  }
  .catalogo-testa { max-width: 44rem; margin-bottom: clamp(2rem, 5vw, 3rem); }
  .catalogo-testa__sub {
    margin-top: 1.2rem;
    font-size: var(--fs-500);
    color: var(--grigio-700);
  }
  /* ⛔ 25/08: "Ventidue corsi in otto aree" occupava la meta' sinistra e la
     destra restava vuota per tutta l'altezza dell'apertura. Stesso rimedio
     delle teste di sezione della home: il titolo a sinistra e la riga di
     spiegazione a destra, appoggiati sulla stessa base. */
  @media (min-width: 62rem) {
    .catalogo-testa--riga {
      max-width: none;
      display: grid;
      grid-template-columns: minmax(0, 1.28fr) minmax(0, 0.72fr);
      grid-template-rows: auto auto;
      column-gap: clamp(2.5rem, 7vw, 6rem);
      align-items: end;
    }
    .catalogo-testa--riga > .eyebrow { grid-column: 1; grid-row: 1; }
    .catalogo-testa--riga > h1 { grid-column: 1; grid-row: 2; }
    .catalogo-testa--riga > .catalogo-testa__sub {
      grid-column: 2;
      grid-row: 2;
      margin-top: 0;
      padding-bottom: 0.5rem;
    }
  }

  /* --- Le otto aree ------------------------------------------------------ */
  /* ⛔ 25/08, deciso da Nicola guardandolo sul telefono: le otto schede vanno
     DUE A DUE anche sullo schermo stretto. A una colonna ogni scheda era alta
     circa 700 px (l'immagine da sola ne prende 292 a 390 px di larghezza), e
     otto schede facevano quasi 5.600 px di scorrimento per vedere un elenco
     di otto voci. Affiancate, si dimezza.
     ⛔ Sotto i 22rem (352 px) si torna a una colonna: piu' stretto di cosi'
     la scheda scende sotto i 145 px e il titolo si spezza in tre righe.
     ⚠️ La soglia era 23rem e lasciava fuori i 360 px, che e' una delle
     larghezze piu' diffuse: misurato, e corretto. */
  .aree-griglia {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 22rem) {
    .aree-griglia { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.85rem; }
  }
  @media (min-width: 48rem) {
    .aree-griglia { gap: 1.25rem; }
  }
  /* Sulle due colonne strette il testo va rifiatato, se no la scheda diventa
     un muro: l'occhiello va su due righe invece che ai due lati, e il corpo
     scende di un gradino. */
  @media (max-width: 47.99rem) {
    .area-card__testo { padding: 0.9rem; gap: 0.35rem; }
    .area-card__eti { flex-direction: column; gap: 0.15rem; }
    .area-card h3 { font-size: 1.05rem; line-height: 1.2; }
    .area-card__occhiello { font-size: var(--fs-200); }
    .area-card__cta { font-size: var(--fs-200); }
  }
  @media (min-width: 40rem) {
    .aree-griglia { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 64rem) {
    .aree-griglia { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
  .area-card {
    display: flex;
    flex-direction: column;
    background: var(--bianco);
    border: 1px solid var(--grigio-100);
    border-radius: var(--radius);
    overflow: hidden;
    color: inherit;
    box-shadow: var(--shadow-sm);
    transition: transform var(--transition), box-shadow var(--transition),
      border-color var(--transition);
  }
  .area-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    border-color: var(--grigio-300);
  }
  .area-card__figura { position: relative; aspect-ratio: 4 / 3; background: var(--carta); }
  .area-card__figura img { width: 100%; height: 100%; object-fit: cover; }
  .area-card__segno {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-family: var(--font-titoli);
    font-size: clamp(3.5rem, 9vw, 5rem);
    font-weight: 900;
    color: var(--grigio-300);
    background-color: var(--grigio-100);
    background-image: linear-gradient(135deg, var(--grigio-100), var(--carta) 65%);
  }
  .area-card__testo { display: flex; flex-direction: column; gap: 0.45rem; padding: 1.2rem; flex-grow: 1; }
  .area-card__eti {
    display: flex;
    justify-content: space-between;
    gap: 0.6rem;
    font-size: var(--fs-200);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--rosso);
  }
  .area-card__eti span { color: var(--grigio-500); letter-spacing: 0.04em; }
  /* ⛔ 25/08 sera, difetto visto da Nicola sul telefono: "Contrattualistica"
     usciva dal bordo della scheda. Sotto i 40rem le schede stanno due per
     riga, quindi la colonna e' larga meno di 180 px: una parola di 17 lettere
     a corpo pieno non ci sta e, senza istruzioni, il browser la lascia
     traboccare invece di spezzarla. La pagina e' in italiano (`lang="it"`),
     quindi la sillabazione taglia dove taglierebbe un tipografo. Il
     `overflow-wrap` resta come rete: se un giorno arriva una parola che il
     dizionario non conosce, si spezza lo stesso invece di uscire. */
  .area-card h3 {
    font-size: var(--fs-500);
    -webkit-hyphens: auto;
    hyphens: auto;
    overflow-wrap: break-word;
  }
  .area-card__occhiello { font-size: var(--fs-300); color: var(--grigio-700); flex-grow: 1; }
  .area-card__cta {
    display: inline-flex;
    align-items: center;
    font-size: var(--fs-300);
    font-weight: 700;
    color: var(--rosso);
  }

  .su-richiesta {
    margin-top: 2.5rem;
    padding: 1.5rem;
    border: 1px dashed var(--grigio-300);
    border-radius: var(--radius);
  }
  .su-richiesta h3 { font-size: var(--fs-500); margin-bottom: 0.4rem; }
  .su-richiesta p { color: var(--grigio-700); font-size: var(--fs-300); }
  .su-richiesta ul { list-style: none; display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 0.9rem; }
  .su-richiesta li {
    background: var(--grigio-100);
    border-radius: 999px;
    padding: 0.3rem 0.85rem;
    font-size: var(--fs-300);
  }
  .su-richiesta strong { color: var(--rosso); margin-right: 0.3rem; }

  /* --- Indice completo, apribile -----------------------------------------
     ⛔ 25/08: la barra chiusa era una riga di testo che galleggiava in mezzo
     a una fascia vuota, e l'anello di messa a fuoco le girava attorno per
     tutta la larghezza. Adesso e' una riga come quelle della home: fondo
     bianco, filetto rosso a sinistra, e si muove quando ci passi sopra, cosi'
     si capisce che si puo' premere. */
  .indice-tutto > summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    cursor: pointer;
    list-style: none;
    padding: 1rem 1.25rem;
    background: var(--bianco);
    border: 1px solid var(--grigio-100);
    border-left: 5px solid var(--rosso);
    border-radius: 6px;
    box-shadow: var(--shadow-sm);
    transition: transform var(--transition), box-shadow var(--transition);
  }
  .indice-tutto > summary::-webkit-details-marker { display: none; }
  @media (hover: hover) {
    .indice-tutto > summary:hover {
      transform: translateX(0.35rem);
      box-shadow: var(--shadow-md);
    }
  }
  /* La messa a fuoco resta visibile ma dentro il bordo, non come una cornice
     rossa larga quanto la pagina. */
  .indice-tutto > summary:focus-visible {
    outline: none;
    box-shadow: 0 0 0 3px rgba(200, 32, 47, 0.35);
  }
  .indice-tutto__testo { display: flex; flex-direction: column; gap: 0.15rem; min-width: 0; }
  .indice-tutto__eti {
    font-size: var(--fs-200);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--grigio-500);
  }
  .indice-tutto__titolo {
    font-family: var(--font-titoli);
    font-size: var(--fs-600);
    font-weight: 900;
    color: var(--nero);
    letter-spacing: -0.015em;
  }
  .indice-tutto__stato {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: var(--fs-300);
    font-weight: 700;
    color: var(--rosso);
  }
  .indice-tutto__stato::before { content: 'Apri'; }
  .indice-tutto[open] .indice-tutto__stato::before { content: 'Chiudi'; }
  .indice-tutto__stato .freccia { transform: rotate(90deg); transition: transform var(--transition); }
  .indice-tutto[open] .indice-tutto__stato .freccia { transform: rotate(-90deg); }
  .indice-tutto__nota {
    margin-block: 1.6rem 2rem;
    max-width: 40rem;
    color: var(--grigio-700);
    font-size: var(--fs-300);
  }

  .indice { margin-bottom: 2.2rem; }
  .indice__area { font-size: var(--fs-600); margin-bottom: 0.7rem; }
  .indice__area a { color: var(--nero); display: inline-flex; align-items: baseline; }
  .indice__area a:hover { color: var(--rosso); }
  .indice__sigla {
    color: var(--rosso);
    margin-right: 0.6rem;
    font-family: var(--font-titoli);
  }
  .indice ul { list-style: none; border-top: 1px solid var(--grigio-300); }
  .indice li { border-bottom: 1px solid var(--grigio-300); }
  .indice li a {
    display: grid;
    grid-template-columns: 2.6rem 1fr;
    align-items: baseline;
    gap: 0.3rem 0.9rem;
    padding: 0.7rem 0.4rem;
    color: var(--nero);
    transition: background var(--transition), padding-left var(--transition);
  }
  .indice li a:hover { background: var(--bianco); padding-left: 0.9rem; }
  .indice__cod {
    font-size: var(--fs-200);
    font-weight: 700;
    color: var(--grigio-500);
    grid-row: span 2;
  }
  .indice__titolo { font-weight: 700; font-size: var(--fs-300); }
  .indice__durata { font-size: var(--fs-200); color: var(--grigio-500); grid-column: 2; }
  .indice__prezzo {
    font-size: var(--fs-300);
    font-weight: 700;
    color: var(--nero);
    grid-column: 2;
    justify-self: start;
  }
  @media (min-width: 48rem) {
    .indice li a { grid-template-columns: 2.6rem minmax(0, 1fr) 12rem 7rem; }
    .indice__durata { grid-column: auto; }
    .indice__prezzo { grid-column: auto; justify-self: end; }
    /* ⛔ 01/09: senza la colonna del prezzo la riga deve tornare a TRE
       colonne, altrimenti resta appesa una quarta colonna da 7rem vuota e la
       durata smette di stare a destra come prima. */
    .indice--senza-prezzo li a { grid-template-columns: 2.6rem minmax(0, 1fr) 12rem; }
  }


</style>
