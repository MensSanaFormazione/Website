---
import Base from '../layouts/Base.astro';
import Freccia from '../components/Freccia.astro';
import { consulenze, areeInLettere } from '../data/corsi.js';

/* ⛔ Le materie NON sono scritte qui: arrivano dal blocco `consulenze` di
   `catalogo.json`, che e' lo stesso che il pannello dell'area riservata
   modifica dalla scheda "Consulenza". Prima del 01/09 quei dati esistevano ma
   non li stampava nessuna pagina, e il pannello prometteva di modificare una
   sezione che sul sito non c'era (voce 84). Se un giorno le materie cambiano,
   si cambiano dal pannello e questa pagina segue da sola. */

const passi = [
  {
    n: '01',
    titolo: 'Ci raccontate il caso',
    testo:
      "Bastano due righe: qual è la situazione, cosa vi preoccupa e con quali tempi. Non serve allegare tutto subito, i documenti si guardano dopo.",
  },
  {
    n: '02',
    titolo: 'Cerchiamo la persona giusta',
    testo:
      "È la materia a decidere il professionista, non il contrario. Se la richiesta è fuori dal nostro perimetro ve lo diciamo subito, invece di provarci.",
  },
  {
    n: '03',
    titolo: 'Ricevete una proposta scritta',
    testo:
      "Che cosa comprende l'incarico, in quanto tempo e a quale compenso: per iscritto e prima di cominciare. Fino a quel momento non avete impegnato nulla.",
  },
  {
    n: '04',
    titolo: 'Il caso viene seguito',
    testo:
      "Si lavora sui vostri documenti e sulla vostra situazione. Finito l'incarico il professionista resta il vostro riferimento, se la questione si riapre.",
  },
];

/* ⛔ Le quattro voci qui sotto rispondono alla domanda che tutti fanno per
   prima, "quanto costa", e servono a spiegare PERCHE' un prezzo non c'e'.
   Senza questo blocco l'assenza del prezzo si legge come reticenza. */
const variabili = [
  {
    titolo: 'La materia',
    testo:
      "Un contratto di fornitura e un fascicolo di transfer pricing non richiedono lo stesso lavoro né lo stesso professionista.",
  },
  {
    titolo: "L'ampiezza dell'incarico",
    testo:
      "Un parere scritto una volta sola non è un'assistenza che vi accompagna per tutta la trattativa o per tutto l'anno.",
  },
  {
    titolo: 'I documenti da esaminare',
    testo:
      "Leggere due pagine non è leggere un contratto quadro con dieci allegati, gli scambi di mail e le condizioni generali della controparte.",
  },
  {
    titolo: 'I tempi',
    testo:
      "Una risposta che serve per la settimana prossima e una che serve entro domani mattina si organizzano in modo diverso.",
  },
];
---

<Base
  title="Consulenza per imprese ed enti | Mens Sana Formazione"
  description="Accanto ai corsi seguiamo il caso specifico: privacy e GDPR, contrattualistica nazionale e internazionale, transfer pricing. Perimetro e compenso scritti prima di iniziare. Milano, dal 2017."
>
  <section class="page-hero">
    <div class="container page-hero__centro">
      <p class="eyebrow">Consulenza</p>
      <h1>Il corso finisce.<br />Il vostro caso <span class="text-rosso">no.</span></h1>
      <p class="page-hero__sub">
        Accanto alla formazione seguiamo la singola situazione, per chi ha
        bisogno di un parere sul proprio caso e non di una lezione. È un
        servizio che affianca i corsi, non che li sostituisce.
      </p>
      <a href="/contatti/" class="btn btn--primary">Parliamone</a>
    </div>
  </section>

  {/* DA DOVE ARRIVA
       ⛔ Questa sezione racconta come il servizio e' nato davvero, e non e'
       colore: e' la ragione per cui possiamo dire "il professionista lo avete
       gia' conosciuto in aula". Se un giorno si accorcia la pagina, questa
       parte NON e' la prima da togliere. */}
  <section class="section">
    <div class="container">
      <div class="section-head section-head--riga reveal">
        {/* ⛔ 01/09, deciso da Nicola guardando la pagina: la riga di
             accompagnamento nella colonna di destra e' stata TOLTA, qui e
             nelle materie. E' la stessa decisione presa il 25/08 sera su
             `/su-misura/`: la testa resta a due colonne per il filetto e per
             l'allineamento col resto del sito, ma la colonna destra e' vuota.
             Se un giorno torna un testo, va li'. */}
        <p class="eyebrow">Da dove arriva</p>
        <h2>Non l'abbiamo deciso a tavolino</h2>
      </div>
      <div class="racconto reveal">
        <p>
          Succede da anni, sempre nello stesso modo. Finita la lezione qualcuno
          resta in aula con una cartella sotto il braccio: un contratto già
          firmato, una procedura interna che non convince, una contestazione
          arrivata la settimana prima. Non chiede di ripetere la lezione,
          chiede di guardare il suo caso.
        </p>
        <p>
          I docenti dei nostri corsi sono professionisti che quella materia la
          praticano ogni giorno, non solo la insegnano. Quando la domanda è
          arrivata hanno detto di sì, e il caso è stato seguito sotto Mens
          Sana. Questa pagina esiste per dire in anticipo una cosa che finora
          si scopriva solo venendo a un corso.
        </p>
        <p class="racconto__forte">
          Non serve aspettare la fine di una lezione per chiedercelo.
        </p>
      </div>
    </div>
  </section>

  {/* LE MATERIE
       Elenco tipografico e non schede: e' lo stesso trattamento delle sei
       leve di `/su-misura/`, cosi' i due servizi che affiancano il catalogo si
       riconoscono allo stesso modo. */}
  <section class="section section--tinted">
    <div class="container">
      <div class="section-head section-head--riga reveal">
        <p class="eyebrow">Le materie</p>
        <h2>Su cosa ci chiamano</h2>
      </div>
      <ul class="leve">
        {consulenze.map((c, i) => (
          <li class="leva reveal" style={`--d: ${i * 0.06}s`}>
            <h3><Freccia classe="leva__segno" />{c.titolo}</h3>
            <p>{c.testo}</p>
          </li>
        ))}
      </ul>
      <p class="materie-nota reveal">
        Se la vostra questione non rientra in queste materie, chiedete lo
        stesso: il perimetro è quello delle
        <a href="/formazione/">{areeInLettere} aree del catalogo</a>, e se non abbiamo la
        persona adatta ve lo diciamo subito.
      </p>
    </div>
  </section>

  {/* COME FUNZIONA */}
  <section class="section">
    <div class="container">
      <div class="section-head section-head--riga reveal">
        <p class="eyebrow">Come funziona</p>
        <h2>Dalla richiesta all'incarico</h2>
      </div>
      <ol class="passi">
        {passi.map((p, i) => (
          <li class="passo reveal" style={`--d: ${i * 0.08}s`}>
            <span class="passo__n">{p.n}</span>
            <h3>{p.titolo}</h3>
            <p>{p.testo}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* IL COMPENSO
       ⛔ Sta su fondo scuro di proposito: e' la domanda che il lettore si fa
       per prima, e su questa pagina e' anche l'unica a cui non diamo un
       numero. Nasconderla in fondo a un paragrafo la farebbe sembrare una
       cosa da non dire. */}
  <section class="section section--dark">
    <div class="container">
      <div class="section-head section-head--riga reveal">
        <p class="eyebrow">Il compenso</p>
        <h2>Perché qui non trovate un prezzo</h2>
        <p>
          Non è una risposta evasiva. Due richieste che sul foglio sembrano
          uguali possono valere una lettura di un'ora oppure un lavoro di mesi:
          un compenso scritto qui sarebbe sbagliato per quasi tutti.
        </p>
      </div>
      <ul class="variabili">
        {variabili.map((v, i) => (
          <li class="variabile reveal" style={`--d: ${i * 0.06}s`}>
            <h3>{v.titolo}</h3>
            <p>{v.testo}</p>
          </li>
        ))}
      </ul>
      <p class="compenso-nota reveal">
        Quello che possiamo dirvi in anticipo è il metodo: prima guardiamo il
        caso, poi vi arriva una proposta scritta con perimetro, tempi e
        compenso, e solo a quel punto decidete.
        <strong>Fino ad allora non avete impegnato nulla.</strong>
      </p>
    </div>
  </section>

  {/* CTA */}
  <section class="section cta-final">
    <div class="container reveal">
      <h2>Raccontateci il caso</h2>
      <p>
        Scriveteci in due righe qual è la situazione: vi diciamo se è materia
        nostra e, se lo è, come la seguiremmo.
      </p>
      <a href="/contatti/" class="btn btn--primary">Parliamone</a>
    </div>
  </section>
</Base>

<style>
  /* --- Apertura -----------------------------------------------------------
     Stesse misure di `/su-misura/`: apertura centrata, niente bordo sotto
     (il fondo dell'apertura e quello della pagina sono lo stesso colore) e
     104 px fra il pulsante e il filetto della sezione dopo. */
  .page-hero__centro {
    max-width: 54rem;
    text-align: center;
  }
  .page-hero__centro .eyebrow { justify-content: center; }
  .page-hero__centro .page-hero__sub { margin-inline: auto; }
  .page-hero {
    background: var(--carta);
    padding-block: clamp(3rem, 8vw, 5.5rem) clamp(2rem, 4vw, 2.75rem);
  }
  .page-hero + .section { padding-top: clamp(2rem, 4vw, 3rem); }
  .page-hero__sub {
    margin-block: 1.5rem 2rem;
    font-size: var(--fs-500);
    color: var(--grigio-700);
    max-width: 44rem;
  }

  /* --- Il racconto --------------------------------------------------------
     Due colonne su schermo largo, una sola sotto i 62rem. La riga forte in
     fondo attraversa tutte e due: e' la frase che deve restare, e in colonna
     si perderebbe in fondo alla seconda. */
  .racconto {
    max-width: 62rem;
  }
  .racconto p {
    color: var(--grigio-700);
    font-size: var(--fs-500);
  }
  .racconto p + p { margin-top: 1rem; }
  .racconto__forte {
    margin-top: clamp(1.5rem, 3vw, 2rem) !important;
    padding-top: clamp(1.25rem, 3vw, 1.75rem);
    border-top: 2px solid var(--grigio-900);
    font-family: var(--font-titoli);
    font-size: var(--fs-700);
    font-weight: 700;
    line-height: 1.25;
    color: var(--nero);
    max-width: 34rem;
  }

  /* --- Le materie ---------------------------------------------------------
     Copiato dalle leve di `/su-misura/`: elenco, non schede. */
  /* ⛔ Qui c'e' una differenza rispetto a `/su-misura/`, e nasce da un difetto
     visto misurando: li' i sei titoli stanno tutti su UNA riga, qui
     "Contrattualistica nazionale e internazionale" ne prende DUE. Senza
     accorgimenti il filetto sotto quel titolo scende, e i tre paragrafi
     partono a tre quote diverse: la colonna di mezzo sembra sfasata.
     Il rimedio e' `subgrid`: ogni voce occupa DUE righe della griglia madre,
     una per il titolo e una per il testo, quindi le voci affiancate
     condividono le stesse righe e i filetti stanno alla stessa quota
     qualunque sia la lunghezza dei titoli. */
  .leve {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1.6rem, 3vw, 2.25rem) clamp(2rem, 5vw, 4rem);
  }
  .leva {
    display: grid;
    grid-row: span 2;
    grid-template-rows: subgrid;
    row-gap: 0;
    align-content: start;
  }
  @media (min-width: 48rem) {
    .leve { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 68rem) {
    .leve { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  .leva h3 {
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
    font-size: var(--fs-600);
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--grigio-300);
  }
  .leva :global(.leva__segno) { flex: none; color: var(--rosso); }
  .leva p { margin-top: 0.7rem; color: var(--grigio-700); }

  .materie-nota {
    margin-top: clamp(2rem, 4vw, 2.75rem);
    max-width: 44rem;
    color: var(--grigio-700);
  }
  .materie-nota a { color: var(--rosso); font-weight: 600; }
  .materie-nota a:hover { color: var(--rosso-scuro); }

  /* --- I quattro passaggi -------------------------------------------------
     Righe incolonnate, non griglia 2x2: un procedimento e' una cosa che
     avanza. Stesse misure di `/su-misura/`. */
  .passi { list-style: none; }
  .passo {
    padding-block: clamp(1.25rem, 3vw, 1.9rem);
    border-top: 1px solid var(--grigio-100);
  }
  .passo:first-child { border-top-color: var(--grigio-900); border-top-width: 2px; }
  .passo:last-child { border-bottom: 1px solid var(--grigio-100); }
  .passo__n {
    display: block;
    font-family: var(--font-titoli);
    font-size: var(--fs-700);
    font-weight: 900;
    line-height: 1;
    color: var(--rosso);
  }
  .passo h3 { margin-block: 0.4rem 0.5rem; font-size: var(--fs-600); }
  .passo p { color: var(--grigio-700); }

  @media (min-width: 62rem) {
    .passo {
      display: grid;
      grid-template-columns: 3.5rem minmax(0, 0.9fr) minmax(0, 1.3fr);
      column-gap: clamp(1.5rem, 4vw, 3.5rem);
      align-items: start;
    }
    .passo__n { grid-column: 1; grid-row: 1; }
    .passo h3 { grid-column: 2; grid-row: 1; margin: 0; padding-top: 0.15rem; }
    .passo p { grid-column: 3; grid-row: 1; }
  }

  /* --- Da cosa dipende il compenso ---------------------------------------
     Quattro voci su fondo scuro. Il filetto sopra il titolo al posto del
     riquadro: sul nero un bordo su quattro lati diventa subito una scheda, e
     di schede in questa pagina non ce n'e' nessun'altra. */
  /* Stesso accorgimento delle materie: due dei quattro titoli vanno a capo. */
  .variabili {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1.5rem, 3vw, 2rem) clamp(2rem, 5vw, 3.5rem);
  }
  .variabile {
    display: grid;
    grid-row: span 2;
    grid-template-rows: subgrid;
    row-gap: 0;
    align-content: start;
  }
  @media (min-width: 48rem) {
    .variabili { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 68rem) {
    .variabili { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
  .variabile h3 {
    font-size: var(--fs-600);
    padding-top: 0.8rem;
    border-top: 1px solid rgba(255, 255, 255, 0.22);
  }
  .variabile p {
    margin-top: 0.6rem;
    color: var(--grigio-300);
    font-size: var(--fs-300);
  }

  .compenso-nota {
    margin-top: clamp(2rem, 4vw, 2.75rem);
    max-width: 48rem;
    color: var(--grigio-300);
    font-size: var(--fs-500);
  }
  .compenso-nota strong { color: var(--bianco); }

  .cta-final { text-align: center; }
  .cta-final .container { max-width: 42rem; }
  .cta-final p {
    margin-block: 1rem 2rem;
    color: var(--grigio-700);
    font-size: var(--fs-500);
  }
</style>
