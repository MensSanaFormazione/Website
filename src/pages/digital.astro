---
import Base from '../layouts/Base.astro';

// Icone SVG inline (stile Lucide): niente emoji, regola di progetto
const icone = {
  globe:
    '<svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>',
  qr:
    '<svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><rect width="5" height="5" x="3" y="3" rx="1"/><rect width="5" height="5" x="16" y="3" rx="1"/><rect width="5" height="5" x="3" y="16" rx="1"/><path d="M21 16h-3a2 2 0 0 0-2 2v3"/><path d="M21 21v.01M12 7v3a2 2 0 0 1-2 2H7"/><path d="M3 12h.01M12 3h.01M12 16v.01M16 12h1M21 12v.01M12 21v-1"/></svg>',
  pin:
    '<svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>',
  palette:
    '<svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 22a10 10 0 1 1 10-10c0 4.42-2.5 5-5 5h-1.5a2.5 2.5 0 0 0-2 4c.34.45.5.94.5 1a1 1 0 0 1-2 0Z"/><circle cx="13.5" cy="6.5" r=".8"/><circle cx="17.5" cy="10.5" r=".8"/><circle cx="8.5" cy="7.5" r=".8"/><circle cx="6.5" cy="12" r=".8"/></svg>',
};

const servizi = [
  {
    icona: 'globe',
    titolo: 'Siti web vetrina',
    testo:
      'Un sito moderno, veloce e pensato prima di tutto per il telefono: chi sei, cosa fai, dove trovarti.',
  },
  {
    icona: 'qr',
    titolo: 'Menu digitali con QR',
    testo:
      'Menu consultabile dal telefono con un QR code brandizzato sul tavolo, aggiornabile senza ristampare nulla.',
  },
  {
    icona: 'pin',
    titolo: 'Presenza online',
    testo:
      'Profilo Google, mappe, orari, recensioni e social collegati, per farti trovare da chi ti cerca in zona.',
  },
  {
    icona: 'palette',
    titolo: 'Grafica e materiali',
    testo:
      'Loghi, biglietti da visita, locandine e materiali coordinati con il sito: un\'immagine sola, riconoscibile ovunque.',
  },
];

// ⛔ Nessun prezzo e nessun riferimento a listini: il ramo digitale non
// pubblica cifre finché non arriva il parere della commercialista.
// I tre livelli descrivono solo l'ampiezza dell'intervento.
const livelli = [
  {
    nome: 'Essenziale',
    per: 'Per esserci, e farlo bene',
    include: [
      'Sito vetrina di una pagina, pensato per il telefono',
      'Dominio e attivazione online seguiti da noi',
      'Profilo Google dell\'attività sistemato',
    ],
    featured: false,
  },
  {
    nome: 'Locali',
    per: 'Pensato per bar e ristoranti',
    include: [
      'Tutto quello dell\'Essenziale',
      'Menu digitale con QR code brandizzato',
      'Più pagine: menu, galleria, eventi',
      'QR pronti da stampare per tavoli e vetrina',
    ],
    featured: true,
  },
  {
    nome: 'Completo',
    per: 'Quando serve rifare tutta l\'immagine',
    include: [
      'Tutto quello del livello Locali',
      'Logo e immagine coordinata',
      'Materiali per la stampa: biglietti, locandine',
      'Impostazione dei social e template per i post',
    ],
    featured: false,
  },
];
---

<Base
  title="Mens Sana Digital | Siti web e menu digitali per piccole attività"
  description="Siti web vetrina, menu digitali con QR code, presenza online e grafica per bar, ristoranti, negozi e piccole imprese. Progetti su misura, preventivo gratuito e senza impegno."
>
  <!-- HERO -->
  <section class="digital-hero">
    <div class="container">
      <p class="eyebrow rise" style="--r: 0">Mens Sana Digital</p>
      <h1 class="rise" style="--r: 1">
        La tua attività merita di<br />
        <span class="glow">farsi trovare online.</span>
      </h1>
      <p class="digital-hero__sub rise" style="--r: 2">
        Siti web, menu digitali e presenza online per bar, ristoranti, negozi e
        piccole imprese. Progetti su misura, senza tecnicismi, con un referente
        diretto a cui chiedere.
      </p>
      <div class="digital-hero__actions rise" style="--r: 3">
        <a href="#servizi" class="btn btn--primary">Cosa possiamo fare</a>
        <a href="/contatti/" class="btn btn--ghost">Richiedi un preventivo</a>
      </div>
    </div>
  </section>

  <!-- SERVIZI -->
  <section class="section" id="servizi">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">Di cosa ci occupiamo</p>
        <h2>Chi ti cerca, ti cerca prima dal telefono</h2>
        <p>
          Se non ti trova, o trova un sito vecchio e illeggibile da mobile, va
          altrove. È lì che interveniamo, in modo semplice e comprensibile.
        </p>
      </div>
      <div class="grid grid--2 grid--servizi">
        {servizi.map((s, i) => (
          <div class="card servizio reveal spot" style={`--d: ${i * 0.08}s`}>
            <span class="servizio__icona" aria-hidden="true" set:html={icone[s.icona]} />
            <div>
              <h3>{s.titolo}</h3>
              <p>{s.testo}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PRIMA / DOPO -->
  <section class="section section--dark">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">Esempio illustrativo</p>
        <h2>La differenza si vede. Trascina e guarda.</h2>
        <p>
          Sposta il cursore: a sinistra un sito datato, a destra l'idea di sito
          verso cui lavoriamo. Sono due schermate di esempio, disegnate per
          questa pagina.
        </p>
      </div>
      <div class="ba reveal" id="ba" style="--pos: 50%">
        <!-- DOPO (sotto, a destra) -->
        <div class="ba__pane ba__dopo" aria-hidden="true">
          <div class="mock mock--new">
            <div class="mock__bar mock__bar--new"><span class="mock__dot"></span>iltuolocale.it</div>
            <div class="mock__body-new">
              <div class="mock__logo"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M15 11h.01M11 15h.01M16 16h.01M2 16l20 6-6-20A20 20 0 0 0 2 16"/><path d="M5.71 17.11a17.04 17.04 0 0 1 11.4-11.4"/></svg> Il Tuo Locale</div>
              <div class="mock__h1">Il nome della tua<br />attività, ben visibile</div>
              <div class="mock__cta">Guarda il menu</div>
              <div class="mock__cards">
                <span></span><span></span><span></span>
              </div>
            </div>
          </div>
        </div>
        <!-- PRIMA (sopra, ritagliato a sinistra) -->
        <div class="ba__pane ba__prima" aria-hidden="true">
          <div class="mock mock--old">
            <div class="mock__bar">www.iltuolocale-sitovecchio.it</div>
            <div class="mock__body-old">
              <div class="mock__title-old">~*~ Benvenuti nel Nostro Sito ~*~</div>
              <div class="mock__img-old">[ foto in caricamento… ]</div>
              <div class="mock__text-old">
                <span></span><span></span><span></span><span></span>
              </div>
              <div class="mock__link-old">Clicca QUI per il menu (PDF, 14 MB)</div>
              <div class="mock__counter">Visite: 000481 | Ultimo aggiornamento: 2019</div>
            </div>
          </div>
        </div>
        <div class="ba__divider" aria-hidden="true"><span class="ba__knob">⇄</span></div>
        <input
          type="range"
          class="ba__range"
          min="0"
          max="100"
          value="50"
          aria-label="Confronto tra il sito prima e dopo"
        />
        <span class="ba__tag ba__tag--prima">Prima</span>
        <span class="ba__tag ba__tag--dopo">Dopo</span>
      </div>
    </div>
  </section>

  <!-- LIVELLI -->
  <section class="section section--tinted" id="livelli">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">Come si compone un progetto</p>
        <h2>Tre livelli su misura</h2>
      </div>
      <div class="grid grid--3 livelli">
        {livelli.map((p) => (
          <article class:list={['card livello reveal spot', { 'livello--featured': p.featured }]}>
            {p.featured && <span class="livello__tag">Consigliato</span>}
            <h3>{p.nome}</h3>
            <p class="livello__per">{p.per}</p>
            <p class="livello__preventivo">Su preventivo</p>
            <ul>
              {p.include.map((voce) => <li>{voce}</li>)}
            </ul>
            <a href="/contatti/" class:list={['btn', p.featured ? 'btn--primary' : 'btn--ghost']}>
              Chiedi un preventivo
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- COME LAVORIAMO -->
  <section class="section section--dark">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">Come lavoriamo</p>
        <h2>Dalla prima chiacchierata al sito online</h2>
      </div>
      <ol class="steps">
        <li class="reveal">
          <strong>1. Chiacchierata</strong>
          <p>Ci racconti la tua attività, di persona o al telefono. Niente questionari infiniti.</p>
        </li>
        <li class="reveal">
          <strong>2. Proposta</strong>
          <p>Ti mandiamo una proposta scritta con contenuti, tempi e condizioni, senza impegno.</p>
        </li>
        <li class="reveal">
          <strong>3. Realizzazione</strong>
          <p>Costruiamo il sito e i materiali. Tu approvi, noi mettiamo online.</p>
        </li>
        <li class="reveal">
          <strong>4. Dopo</strong>
          <p>Concordiamo insieme come gestire aggiornamenti e modifiche successive.</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section section--tinted">
    <div class="container faq-wrap">
      <div class="section-head reveal">
        <p class="eyebrow">Domande frequenti</p>
        <h2>Le domande più comuni</h2>
      </div>
      <div class="faq reveal">
        <details>
          <summary>Quanto tempo ci vuole per avere il sito online?<span class="faq__icon">+</span></summary>
          <div class="faq__body">
            Dipende da quanto è ampio il progetto e da quanto in fretta
            arrivano testi e foto. I tempi li mettiamo per iscritto nella
            proposta, prima di iniziare.
          </div>
        </details>
        <details>
          <summary>Devo essere esperto di tecnologia?<span class="faq__icon">+</span></summary>
          <div class="faq__body">
            No, zero. Ci occupiamo noi della parte tecnica: dominio, messa
            online, impostazione. Tu ci racconti la tua attività.
          </div>
        </details>
        <details>
          <summary>Il menu digitale posso aggiornarlo da solo?<span class="faq__icon">+</span></summary>
          <div class="faq__body">
            Sì, cambi prezzi e piatti in autonomia. In alternativa lo
            aggiorniamo noi: è una delle cose che si concordano nella proposta.
          </div>
        </details>
        <details>
          <summary>Ho già un sito, si può rifare?<span class="faq__icon">+</span></summary>
          <div class="faq__body">
            Sì. Si recupera ciò che vale (testi, foto, dominio) e si ricostruisce
            il resto, moderno e leggibile dal telefono.
          </div>
        </details>
        <details>
          <summary>Il sito resta mio?<span class="faq__icon">+</span></summary>
          <div class="faq__body">
            Sì. Dominio e contenuti restano intestati alla tua attività, e i
            rinnovi annuali di dominio e spazio web te li comunichiamo in
            anticipo. Nessun vincolo di durata.
          </div>
        </details>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section cta-digital">
    <div class="container reveal">
      <h2>Vuoi capire cosa servirebbe alla tua attività?</h2>
      <p>
        Scrivici due righe: guardiamo la situazione e ti diciamo cosa si può
        fare, con un preventivo gratuito e senza impegno.
      </p>
      <a href="/contatti/" class="btn btn--primary">Richiedi un preventivo</a>
    </div>
  </section>

  <!-- NOTA INFORMATIVA (voluta discreta, in fondo alla pagina) -->
  <section class="nota-legale">
    <div class="container">
      <p>
        Mens Sana Digital è il ramo digitale, in fase di avvio, di Mens Sana
        Formazione S.r.l., Via San Francesco d'Assisi 13, 20122 Milano, C.F. e
        P.IVA 10160940960. Non è una società autonoma. I servizi descritti in questa pagina sono presentati a
        titolo informativo e non costituiscono offerta al pubblico ai sensi
        dell'art. 1336 c.c.: contenuti, tempi, modalità e condizioni economiche
        di ogni progetto sono definiti caso per caso in un preventivo scritto,
        gratuito e senza impegno, e la disponibilità dei singoli servizi può
        variare. Le schermate di confronto riportate sopra sono esempi
        illustrativi realizzati per questa pagina e non rappresentano siti
        esistenti né lavori realizzati.
      </p>
    </div>
  </section>
</Base>

<script>
  const ba = document.getElementById('ba');
  const range = ba?.querySelector<HTMLInputElement>('.ba__range');
  range?.addEventListener('input', () => {
    ba?.style.setProperty('--pos', `${range.value}%`);
  });
</script>

<style>
  /* --- Slider Prima/Dopo ------------------------------------------------ */
  .ba {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    aspect-ratio: 16 / 10;
    max-width: 52rem;
    margin-inline: auto;
    box-shadow: var(--shadow-lg);
    user-select: none;
    -webkit-user-select: none;
  }
  @media (max-width: 640px) {
    .ba { aspect-ratio: 4 / 5; }
  }
  .ba__pane { position: absolute; inset: 0; }
  .ba__prima { clip-path: inset(0 calc(100% - var(--pos)) 0 0); }
  .ba__divider {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos);
    width: 3px;
    background: var(--bianco);
    transform: translateX(-50%);
    box-shadow: 0 0 14px rgba(0, 0, 0, 0.35);
    pointer-events: none;
  }
  .ba__knob {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 2.7rem;
    height: 2.7rem;
    border-radius: 50%;
    background: var(--bianco);
    color: var(--rosso);
    display: grid;
    place-items: center;
    font-size: 1.15rem;
    font-weight: 800;
    box-shadow: var(--shadow-md);
  }
  .ba__range {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: ew-resize;
    margin: 0;
    -webkit-appearance: none;
    appearance: none;
    touch-action: none;
  }
  .ba__tag {
    position: absolute;
    top: 0.9rem;
    font-size: var(--fs-200);
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.3rem 0.8rem;
    border-radius: 999px;
    pointer-events: none;
  }
  .ba__tag--prima { left: 0.9rem; background: rgba(0, 0, 0, 0.55); color: #fff; }
  .ba__tag--dopo { right: 0.9rem; background: var(--rosso); color: #fff; }

  /* Mockup "prima": il sito datato */
  .mock { position: absolute; inset: 0; display: flex; flex-direction: column; }
  .mock__bar {
    background: #d5d1c8;
    color: #555;
    font-size: 0.72rem;
    padding: 0.45rem 0.9rem;
    font-family: 'Courier New', monospace;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .mock--old { background: #efe9da; }
  .mock__body-old {
    flex: 1;
    padding: clamp(0.8rem, 3vw, 1.8rem);
    font-family: 'Times New Roman', Times, serif;
    color: #333;
    display: flex;
    flex-direction: column;
    gap: clamp(0.5rem, 2vw, 1rem);
    align-items: center;
    text-align: center;
  }
  .mock__title-old {
    font-size: clamp(0.95rem, 2.6vw, 1.5rem);
    font-weight: bold;
    color: #7b0000;
  }
  .mock__img-old {
    width: min(60%, 16rem);
    aspect-ratio: 4 / 2.1;
    border: 2px dashed #999;
    background: #e2dccb;
    display: grid;
    place-items: center;
    color: #888;
    font-size: clamp(0.6rem, 1.8vw, 0.8rem);
  }
  .mock__text-old { width: 80%; display: flex; flex-direction: column; gap: 0.45rem; }
  .mock__text-old span { height: 6px; background: #cfc8b4; }
  .mock__text-old span:last-child { width: 62%; margin-inline: auto; }
  .mock__link-old {
    color: #0000cc;
    text-decoration: underline;
    font-size: clamp(0.7rem, 2vw, 0.95rem);
  }
  .mock__counter {
    font-size: clamp(0.58rem, 1.6vw, 0.72rem);
    color: #777;
    font-family: 'Courier New', monospace;
  }

  /* Mockup "dopo": il sito moderno */
  .mock--new { background: var(--nero); }
  .mock__bar--new { background: #101014; color: #9a9da6; }
  .mock__dot { width: 8px; height: 8px; border-radius: 50%; background: var(--rosso); }
  .mock__body-new {
    flex: 1;
    padding: clamp(0.9rem, 3vw, 2rem);
    display: flex;
    flex-direction: column;
    gap: clamp(0.6rem, 2.2vw, 1.1rem);
    align-items: center;
    justify-content: center;
    text-align: center;
    background:
      radial-gradient(ellipse 60% 50% at 85% 0%, rgba(200, 32, 47, 0.25), transparent);
  }
  .mock__logo { color: #fff; font-weight: 800; font-size: clamp(0.8rem, 2.2vw, 1rem); }
  .mock__h1 {
    color: #fff;
    font-weight: 800;
    font-size: clamp(1.05rem, 3.4vw, 1.9rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
  }
  .mock__cta {
    background: var(--rosso);
    color: #fff;
    font-weight: 700;
    font-size: clamp(0.65rem, 1.9vw, 0.85rem);
    padding: 0.5em 1.3em;
    border-radius: 999px;
  }
  .mock__cards { display: flex; gap: 0.6rem; width: 100%; margin-top: auto; }
  .mock__cards span {
    flex: 1;
    height: clamp(2rem, 7vw, 3.4rem);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.09);
    border: 1px solid rgba(255, 255, 255, 0.12);
  }

  /* --- FAQ ---------------------------------------------------------------- */
  .faq-wrap { max-width: 46rem; }
  .faq { display: flex; flex-direction: column; gap: 0.8rem; }
  .faq details {
    background: var(--bianco);
    border: 1px solid var(--grigio-100);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    transition: border-color var(--transition);
  }
  .faq details[open] { border-color: var(--rosso); }
  .faq summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.1rem 1.4rem;
    font-weight: 700;
    color: var(--nero);
  }
  .faq summary::-webkit-details-marker { display: none; }
  .faq__icon {
    flex-shrink: 0;
    width: 1.7rem;
    height: 1.7rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--rosso-tenue);
    color: var(--rosso);
    font-weight: 800;
    transition: transform var(--transition), background var(--transition), color var(--transition);
  }
  .faq details[open] .faq__icon {
    transform: rotate(45deg);
    background: var(--rosso);
    color: var(--bianco);
  }
  .faq__body {
    padding: 0 1.4rem 1.2rem;
    color: var(--grigio-700);
    font-size: var(--fs-300);
    animation: faq-open 0.3s ease;
  }
  @keyframes faq-open {
    from { opacity: 0; transform: translateY(-6px); }
    to { opacity: 1; transform: none; }
  }

  .digital-hero {
    background:
      radial-gradient(ellipse 70% 60% at 15% 0%, rgba(200, 32, 47, 0.28), transparent),
      var(--nero);
    color: var(--grigio-300);
    padding-block: clamp(4rem, 10vw, 8rem);
  }
  .digital-hero h1 { color: var(--bianco); }
  .glow { color: var(--rosso); text-shadow: 0 0 40px rgba(200, 32, 47, 0.45); }
  .digital-hero__sub {
    margin-top: 1.5rem;
    max-width: 38rem;
    font-size: var(--fs-500);
  }
  .digital-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 2.2rem;
  }
  .digital-hero .btn--ghost { border-color: var(--grigio-700); color: var(--bianco); }
  .digital-hero .btn--ghost:hover { border-color: var(--bianco); }

  /* ⛔ Le quattro card vanno 2x2. La griglia standard `.grid--2` e'
     `auto-fit`, e su schermo largo ci fa stare tre colonne: la quarta card
     resta sola in fondo e la sezione sembra incompiuta. Qui le colonne sono
     fissate a due. */
  .grid--servizi { grid-template-columns: 1fr; }
  @media (min-width: 48rem) {
    .grid--servizi { grid-template-columns: repeat(2, 1fr); }
  }

  .servizio { display: flex; gap: 1.1rem; align-items: flex-start; }
  .servizio__icona {
    display: grid;
    place-items: center;
    width: 3.2rem;
    height: 3.2rem;
    flex-shrink: 0;
    border-radius: 12px;
    background: var(--rosso-tenue);
    color: var(--rosso);
  }
  .servizio__icona :global(.ico) { width: 1.6rem; height: 1.6rem; }
  .servizio h3 { margin-bottom: 0.35rem; }
  .servizio p { color: var(--grigio-700); font-size: var(--fs-300); }

  .livelli { align-items: stretch; }
  .livello {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    position: relative;
    /* ⛔ Spazio in alto UGUALE su tutte e tre le card, non solo su quella
