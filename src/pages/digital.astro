---
import Base from '../layouts/Base.astro';

// Icone SVG inline (stile Lucide): niente emoji, regola di progetto
const icone = {
  globe:
    '<svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>',
  qr:
    '<svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><rect width="5" height="5" x="3" y="3" rx="1"/><rect width="5" height="5" x="16" y="3" rx="1"/><rect width="5" height="5" x="3" y="16" rx="1"/><path d="M21 16h-3a2 2 0 0 0-2 2v3"/><path d="M21 21v.01M12 7v3a2 2 0 0 1-2 2H7"/><path d="M3 12h.01M12 3h.01M12 16v.01M16 12h1M21 12v.01M12 21v-1"/></svg>',
  pin:
    '<svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>',
  palette:
    '<svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 22a10 10 0 1 1 10-10c0 4.42-2.5 5-5 5h-1.5a2.5 2.5 0 0 0-2 4c.34.45.5.94.5 1a1 1 0 0 1-2 0Z"/><circle cx="13.5" cy="6.5" r=".8"/><circle cx="17.5" cy="10.5" r=".8"/><circle cx="8.5" cy="7.5" r=".8"/><circle cx="6.5" cy="12" r=".8"/></svg>',
};

const servizi = [
  {
    icona: 'globe',
    titolo: 'Siti web vetrina',
    testo:
      'Un sito moderno, veloce e pensato prima di tutto per il telefono: chi sei, cosa fai, dove trovarti.',
  },
  {
    icona: 'qr',
    titolo: 'Menu digitali con QR',
    testo:
      'Menu consultabile dal telefono con un QR code brandizzato sul tavolo, aggiornabile senza ristampare nulla.',
  },
  {
    icona: 'pin',
    titolo: 'Presenza online',
    testo:
      'Profilo Google, mappe, orari, recensioni e social collegati, per farti trovare da chi ti cerca in zona.',
  },
  {
    icona: 'palette',
    titolo: 'Grafica e materiali',
    testo:
      'Biglietti da visita, locandine e materiali coordinati con il sito: un\'immagine sola, riconoscibile ovunque.',
  },
];

// ⛔ Nessun prezzo e nessun riferimento a listini: il ramo digitale non
// pubblica cifre finché non arriva il parere della commercialista.
// I tre livelli descrivono solo l'ampiezza dell'intervento.
// ⛔ 25/08 sera, deciso da Nicola: i tre livelli hanno nomi inglesi.
// Essential e Table li ha scelti lui; Hospitality, proposto per il secondo,
// e' stato scartato. Ognuno dei tre dice COSA fa invece di dire quanto e'
// grande: esserci, il tavolo, l'immagine.
const livelli = [
  {
    nome: 'Essential',
    per: 'Per esserci, e farlo bene',
    include: [
      'Sito vetrina di una pagina',
      'Ti gestiamo noi la messa online del sito: registrazione del dominio, hosting, certificato di sicurezza e rinnovi annuali. Non devi entrare in nessun pannello di controllo né parlare con nessun fornitore.',
    ],
    featured: false,
  },
  {
    nome: 'Table',
    per: 'Pensato per bar e ristoranti',
    include: [
      'Tutto quello di Essential',
      'Menu digitale con QR code brandizzato',
      'Più pagine: menu, galleria, eventi',
      'QR pronti da stampare per tavoli e vetrina',
    ],
    featured: true,
  },
  {
    nome: 'Brand',
    per: 'Quando serve rifare tutta l\'immagine',
    include: [
      'Tutto quello di Table',
      'Ci dici come vuoi essere visto e costruiamo l\'immagine su quello: la decidi tu, noi la portiamo su tutto quello che il locale mostra.',
      'Materiali per la stampa: biglietti, locandine',
      'Impostazione dei social e template per i post',
    ],
    featured: false,
  },
];
---

<Base
  title="Mens Sana Digital | Siti web e menu digitali per piccole attività"
  description="Siti web vetrina, menu digitali con QR code, presenza online e grafica per bar, ristoranti, negozi e piccole imprese. Progetti su misura, preventivo gratuito e senza impegno."
>
  <!-- HERO -->
  <section class="digital-hero">
    <div class="container">
      <p class="eyebrow rise" style="--r: 0">Mens Sana Digital</p>
      <h1 class="rise" style="--r: 1">
        La tua attività merita di<br />
        <span class="glow">farsi trovare online.</span>
      </h1>
      <p class="digital-hero__sub rise" style="--r: 2">
        Siti web, menu digitali e presenza online per bar, ristoranti, negozi e
        piccole imprese. Progetti su misura, senza tecnicismi, con un referente
        diretto a cui chiedere.
      </p>
      <div class="digital-hero__actions rise" style="--r: 3">
        <a href="#servizi" class="btn btn--primary">Cosa possiamo fare</a>
        <a href="/contatti/" class="btn btn--ghost">Richiedi un preventivo</a>
      </div>
    </div>
  </section>

  <!-- SERVIZI -->
  <section class="section" id="servizi">
    <div class="container">
      <!-- ⛔ 25/08 sera, richiesta di Nicola: "più essenziale". Erano quattro
           schede bianche col bordo, l'ombra e l'icona dentro una piastrella
           rosa: tre contenitori uno dentro l'altro per dire quattro cose
           corte. Adesso restano il segno, il titolo e la riga di testo, e le
           quattro voci sono divise da un filetto. Le icone restano perché
           dicono QUALE servizio è (globo, QR, mappa, tavolozza), la
           piastrella no: era decorazione attorno alla decorazione.
           ⛔ Testa di sezione a due colonne come nel resto del sito: il
           titolo su due righe lasciava vuota la metà destra dello schermo. -->
      <div class="section-head section-head--riga reveal">
        <p class="eyebrow">Di cosa ci occupiamo</p>
        <h2>Chi ti cerca, ti cerca prima dal telefono</h2>
        <p>
          Se non ti trova, o trova un sito vecchio e illeggibile da mobile, va
          altrove. È lì che interveniamo, in modo semplice e comprensibile.
        </p>
      </div>
      <ul class="servizi">
        {servizi.map((s, i) => (
          <li class="servizio reveal" style={`--d: ${i * 0.06}s`}>
            <h3>
              <span class="servizio__icona" aria-hidden="true" set:html={icone[s.icona]} />
              {s.titolo}
            </h3>
            <p>{s.testo}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- PRIMA / DOPO
       ⛔ 25/08 sera, rifatto su richiesta di Nicola ("mi piace ma e' troppo
       semplice"). Il difetto vero non era la semplicita': i due finti siti
       erano IMPAGINATI DIVERSI, quindi tagliandoli a meta' con il cursore si
       vedevano due pezzi che non combaciavano e il lato destro sembrava
       rotto, non migliore. ⛔ Adesso i due pannelli hanno la STESSA identica
       struttura riga per riga (barra, marchio, titolo, immagine, testo,
       azione, piede): scorrendo il cursore ogni elemento si trasforma nel suo
       corrispondente, ed e' li' che si vede la differenza.
       ⛔ E il confronto ora si muove DA SOLO la prima volta che entra nello
       schermo: fermo, nessuno capisce che si puo' trascinare. -->
  <section class="section section--dark">
    <div class="container">
      <div class="section-head section-head--riga reveal">
        <p class="eyebrow">Esempio illustrativo</p>
        <h2>La differenza si vede.<br />Trascina e guarda.</h2>
        <p>
          Stessa attività, stessa pagina, due modi di presentarla. Sposta il
          cursore e guarda cambiare una riga alla volta: sono due schermate di
          esempio, disegnate per questa pagina.
        </p>
      </div>
      <div class="ba reveal" id="ba" style="--pos: 50%">
        <!-- DOPO (sotto, a destra)
             ⛔ 25/08 sera, richiesta di Nicola: qui dentro devono esserci le
             cose che si vedono davvero nella prima schermata di un sito, non
             un titolo e basta. Barra di navigazione col marchio e il pulsante
             di prenotazione, titolo, riga di presentazione, foto, la riga con
             recensioni e orario, l'azione, i recapiti in fondo.
             ⛔ Ogni riga ha la sua GEMELLA nel pannello "prima": stessa
             posizione, stessa altezza, contenuto d'epoca. E' quello che fa
             funzionare il taglio del cursore. -->
        <div class="ba__pane ba__dopo" aria-hidden="true">
          <div class="mock mock--new">
            <div class="mock__bar">
              <svg class="mock__ico" viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
              <span class="mock__url">iltuolocale.it</span>
            </div>
            <div class="mock__corpo">
              <div class="mock__nav">
                <span class="mock__marchio">Il Tuo Locale</span>
                <span class="mock__voci"><span>Menu</span><span>Dove siamo</span><span>Contatti</span></span>
                <span class="mock__pillola">Prenota</span>
              </div>
              <div class="mock__titolo">Il nome della tua attività, ben visibile</div>
              <div class="mock__sotto">Cucina di mare e forno a legna, nel centro di Cagliari.</div>
              <div class="mock__foto"></div>
              <div class="mock__info">
                <span class="mock__stelle" aria-hidden="true">
                  <svg viewBox="0 0 24 24"><path d="m12 3 2.7 5.5 6.1.9-4.4 4.3 1 6.1-5.4-2.9-5.4 2.9 1-6.1L3.2 9.4l6.1-.9z"/></svg>
                  <b>4,8</b> su Google
                </span>
                <span class="mock__punto">Aperto fino alle 24</span>
                <span class="mock__punto">070 123 456</span>
              </div>
              <div class="mock__azione">Guarda il menu</div>
              <div class="mock__piede">Via Roma 1, Cagliari · Chiuso il lunedì</div>
            </div>
          </div>
        </div>
        <!-- PRIMA (sopra, ritagliato a sinistra) -->
        <div class="ba__pane ba__prima" aria-hidden="true">
          <div class="mock mock--old">
            <div class="mock__bar">
              <svg class="mock__ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 2 20h20L12 3z"/><path d="M12 10v4"/><path d="M12 17h.01"/></svg>
              <span class="mock__url">www.iltuolocale-sitovecchio.it</span>
              <span class="mock__nota">Non sicuro</span>
            </div>
            <div class="mock__corpo">
              <div class="mock__nav">
                <span class="mock__marchio">~*~ Il Tuo Locale ~*~</span>
                <span class="mock__voci"><span>Home</span><span>Chi siamo</span><span>Guestbook</span></span>
                <span class="mock__pillola">Entra</span>
              </div>
              <div class="mock__titolo">Benvenuti nel Nostro Sito</div>
              <div class="mock__sotto">Questo sito è ottimizzato per Internet Explorer 1024x768.</div>
              <div class="mock__foto"><span>[ foto in caricamento… ]</span></div>
              <div class="mock__info">
                <span class="mock__stelle">Tel/Fax 070.123456</span>
                <span class="mock__punto">P.IVA 00000000000</span>
                <span class="mock__punto">Best viewed 800x600</span>
              </div>
              <div class="mock__azione">Clicca QUI per il menu (PDF, 14 MB)</div>
              <div class="mock__piede">Visite: 000481 | Ultimo aggiornamento: 2019</div>
            </div>
          </div>
        </div>
        <div class="ba__divider" aria-hidden="true">
          <span class="ba__knob">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 7 4 12l5 5"/><path d="M15 7l5 5-5 5"/></svg>
          </span>
        </div>
        <input
          type="range"
          class="ba__range"
          min="0"
          max="100"
          value="50"
          aria-label="Confronto tra il sito prima e dopo"
        />
        <span class="ba__tag ba__tag--prima">Prima</span>
        <span class="ba__tag ba__tag--dopo">Dopo</span>
      </div>
    </div>
  </section>

  <!-- LIVELLI -->
  <section class="section section--tinted" id="livelli">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">Come si compone un progetto</p>
        <h2>Tre livelli su misura</h2>
      </div>
      <div class="grid grid--3 livelli">
        {livelli.map((p) => (
          <article class:list={['card livello reveal spot', { 'livello--featured': p.featured }]}>
            {p.featured && <span class="livello__tag">Consigliato</span>}
            <h3>{p.nome}</h3>
            <p class="livello__per">{p.per}</p>
            <p class="livello__preventivo">Su preventivo</p>
            <ul>
              {p.include.map((voce) => <li>{voce}</li>)}
            </ul>
            <a href="/contatti/" class:list={['btn', p.featured ? 'btn--primary' : 'btn--ghost']}>
              Richiedi un preventivo
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- COME LAVORIAMO -->
  <section class="section section--dark">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">Come lavoriamo</p>
        <h2>Dalla prima chiacchierata al sito online</h2>
      </div>
      <ol class="steps">
        <li class="reveal">
          <strong>1. Chiacchierata</strong>
          <p>Ci racconti la tua attività, di persona o al telefono. Niente questionari infiniti.</p>
        </li>
        <li class="reveal">
          <strong>2. Proposta</strong>
          <p>Ti mandiamo una proposta scritta con contenuti, tempi e condizioni, senza impegno.</p>
        </li>
        <li class="reveal">
          <strong>3. Realizzazione</strong>
          <p>Costruiamo il sito e i materiali. Tu approvi, noi mettiamo online.</p>
        </li>
        <li class="reveal">
          <strong>4. Dopo</strong>
          <p>Concordiamo insieme come gestire aggiornamenti e modifiche successive.</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section section--tinted">
    <div class="container faq-wrap">
      <div class="section-head reveal">
        <p class="eyebrow">Domande frequenti</p>
        <h2>Le domande più comuni</h2>
      </div>
      <div class="faq reveal">
        <details>
          <summary>Quanto tempo ci vuole per avere il sito online?<span class="faq__icon">+</span></summary>
          <div class="faq__body">
            Dipende da quanto è ampio il progetto e da quanto in fretta
            arrivano testi e foto. I tempi li mettiamo per iscritto nella
            proposta, prima di iniziare.
          </div>
        </details>
        <details>
          <summary>Devo essere esperto di tecnologia?<span class="faq__icon">+</span></summary>
          <div class="faq__body">
            No, zero. Ci occupiamo noi della parte tecnica: dominio, messa
            online, impostazione. Tu ci racconti la tua attività.
          </div>
        </details>
        <details>
          <summary>Il menu digitale posso aggiornarlo da solo?<span class="faq__icon">+</span></summary>
          <div class="faq__body">
            Sì, cambi prezzi e piatti in autonomia. In alternativa lo
            aggiorniamo noi: è una delle cose che si concordano nella proposta.
          </div>
        </details>
        <details>
          <summary>Ho già un sito, si può rifare?<span class="faq__icon">+</span></summary>
          <div class="faq__body">
            Sì. Si recupera ciò che vale (testi, foto, dominio) e si ricostruisce
            il resto, moderno e leggibile dal telefono.
          </div>
        </details>
        <details>
          <summary>Il sito resta mio?<span class="faq__icon">+</span></summary>
          <div class="faq__body">
            Sì. Dominio e contenuti restano intestati alla tua attività, e i
            rinnovi annuali di dominio e spazio web te li comunichiamo in
            anticipo. Nessun vincolo di durata.
          </div>
        </details>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section cta-digital">
    <div class="container reveal">
      <h2>Vuoi capire cosa servirebbe alla tua attività?</h2>
      <p>
        Scrivici due righe: guardiamo la situazione e ti diciamo cosa si può
        fare, con un preventivo gratuito e senza impegno.
      </p>
      <a href="/contatti/" class="btn btn--primary">Richiedi un preventivo</a>
    </div>
  </section>

  <!-- NOTA INFORMATIVA (voluta discreta, in fondo alla pagina) -->
  <section class="nota-legale">
    <div class="container">
      <p>
        Mens Sana Digital è il ramo digitale, in fase di avvio, di Mens Sana
        Formazione S.r.l., Via San Francesco d'Assisi 13, 20122 Milano, C.F. e
        P.IVA 10160940960. Non è una società autonoma. I servizi descritti in questa pagina sono presentati a
        titolo informativo e non costituiscono offerta al pubblico ai sensi
        dell'art. 1336 c.c.: contenuti, tempi, modalità e condizioni economiche
        di ogni progetto sono definiti caso per caso in un preventivo scritto,
        gratuito e senza impegno, e la disponibilità dei singoli servizi può
        variare. Le schermate di confronto riportate sopra sono esempi
        illustrativi realizzati per questa pagina e non rappresentano siti
        esistenti né lavori realizzati.
      </p>
    </div>
  </section>
</Base>

<script>
  /* Confronto prima/dopo.
     ⛔ 25/08: fermo al 50% non si capiva che si potesse trascinare, e chi non
     ci passava sopra vedeva due mezze schermate senza capire il perche'.
     Adesso la prima volta che entra nello schermo il cursore si muove da
     solo: scopre il sito vecchio, poi scivola a mostrare quello nuovo e si
     ferma poco oltre la meta'. Al primo tocco la dimostrazione si annulla e
     comanda solo la mano di chi guarda. */
  const ba = document.getElementById('ba');
  const range = ba?.querySelector<HTMLInputElement>('.ba__range');

  if (ba && range) {
    const metti = (v: number) => {
      ba.style.setProperty('--pos', `${v}%`);
      range.value = String(Math.round(v));
    };

    let dimostrazione = 0;
    const fermaDimostrazione = () => {
      if (dimostrazione) cancelAnimationFrame(dimostrazione);
      dimostrazione = 0;
      ba.classList.add('ba--toccato');
    };

    range.addEventListener('input', () => {
      fermaDimostrazione();
      ba.style.setProperty('--pos', `${range.value}%`);
    });
    ba.addEventListener('pointerdown', fermaDimostrazione);

    const pochoMoto = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    /* Tappe: dove andare e in quanto tempo. La prima e' lenta perche' e'
       quella che dice "questo si muove", le altre accompagnano. */
    const tappe: [number, number][] = [[88, 900], [18, 1400], [54, 900]];

    function corri(i: number) {
      if (i >= tappe.length) { dimostrazione = 0; return; }
      const [meta, durata] = tappe[i];
      const partenza = parseFloat(range.value);
      const t0 = performance.now();
      const passo = (t: number) => {
        const k = Math.min(1, (t - t0) / durata);
        /* Partenza e arrivo morbidi: un cursore che parte di scatto sembra
           un difetto, non un invito. */
        const e = k < 0.5 ? 4 * k * k * k : 1 - Math.pow(-2 * k + 2, 3) / 2;
        metti(partenza + (meta - partenza) * e);
        if (k < 1) { dimostrazione = requestAnimationFrame(passo); }
        else { dimostrazione = requestAnimationFrame(() => corri(i + 1)); }
      };
      dimostrazione = requestAnimationFrame(passo);
    }

    if (!pochoMoto) {
      const osservatore = new IntersectionObserver((voci) => {
        voci.forEach((v) => {
          if (!v.isIntersecting) return;
          osservatore.disconnect();
          if (!ba.classList.contains('ba--toccato')) setTimeout(() => corri(0), 350);
        });
      }, { threshold: 0.45 });
      osservatore.observe(ba);
    }
  }
</script>

<style>
  /* --- Slider Prima/Dopo ------------------------------------------------ */
  .ba {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    aspect-ratio: 16 / 10;
    max-width: 52rem;
    margin-inline: auto;
    box-shadow: var(--shadow-lg);
    user-select: none;
    -webkit-user-select: none;
  }
  @media (max-width: 640px) {
    .ba { aspect-ratio: 4 / 5; }
  }
  /* ⛔ Su schermo stretto le voci del menu e la riga di presentazione si
     tolgono da TUTTI E DUE i pannelli insieme: se sparissero solo da uno, le
     righe non combacerebbero piu' e il confronto perderebbe il senso. */
  @media (max-width: 30rem) {
    .mock__voci,
    .mock__sotto { display: none; }
  }
  .ba__pane { position: absolute; inset: 0; }
  .ba__prima { clip-path: inset(0 calc(100% - var(--pos)) 0 0); }
  .ba__divider {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos);
    width: 3px;
    background: var(--bianco);
    transform: translateX(-50%);
    box-shadow: 0 0 14px rgba(0, 0, 0, 0.35);
    pointer-events: none;
  }
  .ba__knob {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 2.7rem;
    height: 2.7rem;
    border-radius: 50%;
    background: var(--bianco);
    color: var(--rosso);
    display: grid;
    place-items: center;
    box-shadow: var(--shadow-md);
  }
  .ba__knob svg {
    width: 1.15rem;
    height: 1.15rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  /* Il polso che invita: pulsa finche' nessuno ha ancora toccato il cursore,
     e smette per sempre al primo tocco. ⛔ Niente pulsazione se chi guarda ha
     chiesto meno animazioni. */
  .ba:not(.ba--toccato) .ba__knob { animation: ba-invito 2.4s ease-in-out infinite; }
  @keyframes ba-invito {
    0%, 100% { box-shadow: var(--shadow-md), 0 0 0 0 rgba(255, 255, 255, 0.5); }
    50% { box-shadow: var(--shadow-md), 0 0 0 12px rgba(255, 255, 255, 0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .ba:not(.ba--toccato) .ba__knob { animation: none; }
  }
  .ba__range {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: ew-resize;
    margin: 0;
    -webkit-appearance: none;
    appearance: none;
    touch-action: none;
  }
  .ba__tag {
    position: absolute;
    top: 0.9rem;
    font-size: var(--fs-200);
    font-weight: 800;
