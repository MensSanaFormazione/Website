---
import Base from '../layouts/Base.astro';
import Freccia from '../components/Freccia.astro';
import { aree } from '../data/corsi.js';

/* PAGINA "LAVORA CON NOI", chiesta da Nicola il 01/09.
   ⛔ Non è una pagina di contorno: è il canale di ricerca docenti che oggi
   NON esiste più. L'annuncio LinkedIn del 27/08 è stato sospeso in quindici
   ore per il tetto di candidature delle offerte gratuite (voce 78), e le
   candidature spontanee finora arrivavano solo per mail.

   ⛔ TRE COSE CHE QUESTA PAGINA NON DEVE FARE, e valgono come le regole delle
   storie in `build_storie_docenti.py`:
     - NIENTE COMPENSI e NIENTE CIFRE: non sono decisi, e una pagina non è il
       posto dove deciderli;
     - NIENTE VOLUMI e NIENTE PROMESSE DI CONTINUITÀ: non sappiamo quante
       edizioni faremo, e scriverlo sarebbe una promessa che non regge;
     - NIENTE PROMESSA DI RISPOSTA A TERMINE. ⛔ Su `/contatti/` la promessa
       "entro un giorno lavorativo" c'è ed è voluta, qui no: il difetto
       storico documentato è che le richieste muoiono alla prima mail, e una
       promessa scritta e non mantenuta a un professionista costa più del
       silenzio.

   ⛔ LA PARTITA IVA STA IN APERTURA E NEL MODULO, non solo nella riga dei
   requisiti. È la lezione della voce 78 (la domanda di screening non era
   stata messa e il tetto si è consumato con profili fuori bersaglio) ed è la
   stessa scelta fatta il 01/09 sulle cinque storie, dove sta nel corpo del
   testo di tutte e cinque. */

/* ⛔ L'illustrazione è la stessa famiglia delle storie "ricerca docenti"
   (`Social/Instagram/Storie/RICERCA DOCENTI/personaggi/01.png`, generata da
   Nicola con ChatGPT il 01/09). Chiesto da Nicola: chi vede le storie e poi
   arriva qui deve riconoscere la stessa cosa. Sul sito è ridotta ad altezza
   1000 px e convertita in WebP come le otto immagini delle aree. */

const requisiti = [
  {
    titolo: 'Esperienza vera sulla materia',
    testo:
      "Non basta averla studiata: cerchiamo chi la pratica, in studio, in azienda o dentro un ente, e che in aula può portare casi suoi.",
  },
  {
    titolo: 'Partita IVA',
    testo:
      "È un incarico professionale: non è un'assunzione e non è una prestazione occasionale. Senza partita IVA non possiamo affidare la docenza.",
  },
  {
    titolo: 'Lezioni a distanza e in diretta',
    testo:
      "I nostri corsi si tengono a distanza e in diretta, l'area coaching compresa. Il posto da cui insegnate non conta e non ci sono trasferte, ma un'aula che non avete davanti si tiene in modo diverso.",
  },
  {
    titolo: 'Un profilo che possiamo riscontrare',
    testo:
      "Dove avete lavorato e su cosa lavorate adesso. Un profilo LinkedIn o un sito bastano: il curriculum lo chiediamo dopo, se andiamo avanti.",
  },
];

const passi = [
  {
    n: '01',
    titolo: 'Ci mandate il modulo',
    testo:
      "Materia, esperienza e due righe su di voi. Se avete già guardato il catalogo, indicate il codice del corso: è il modo più rapido per capirci.",
  },
  {
    n: '02',
    titolo: 'Guardiamo il profilo',
    testo:
      "Confrontiamo la vostra materia con i corsi che hanno bisogno di un docente. Se in questo momento non c'è spazio ve lo diciamo, invece di lasciarvi in attesa.",
  },
  {
    n: '03',
    titolo: 'Un colloquio sulla materia',
    testo:
      "Non è un colloquio di lavoro: si parla di contenuti, di come imposterete le ore e di cosa avete già insegnato.",
  },
  {
    n: '04',
    titolo: "L'incarico si mette per iscritto",
    testo:
      "Che cosa comprende la docenza, quando si tiene e a quale compenso: per iscritto e prima di cominciare. Fino a quel punto non avete impegnato nulla.",
  },
];
---

<Base
  title="Lavora con noi: cerchiamo docenti | Mens Sana Formazione"
  description="Cerchiamo docenti per le otto aree del nostro catalogo Legal & Compliance: professionisti con esperienza vera sulla materia e partita IVA. Lezioni a distanza e in diretta, nessuna trasferta. Candidatevi dal modulo."
>
  {/* APERTURA
       ⛔ Due colonne di proposito: a sinistra il testo, a destra la figura.
       Sotto i 62rem la figura scende sotto il testo e NON sparisce: è il
       segnale che rende la pagina riconoscibile a chi arriva dalle storie. */}
  <section class="page-hero page-hero--figura">
    <div class="container apertura">
      <div class="apertura__testo">
        <p class="eyebrow">Lavora con noi</p>
        <h1>Insegnate quello che praticate<span class="text-rosso">.</span></h1>
        <p class="page-hero__sub">
          Cerchiamo docenti per i corsi delle otto aree del nostro catalogo:
          professionisti che la materia la esercitano ogni giorno, non solo la
          raccontano. Sono incarichi a collaboratori con partita IVA:
          <strong>non stiamo cercando dipendenti.</strong>
        </p>
        <ul class="fatti">
          <li>
            <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="13" rx="2"/><path d="M8 21h8"/><path d="M12 17v4"/></svg>
            <span>A distanza e in diretta</span>
          </li>
          <li>
            <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-7-5.2-7-10a7 7 0 0 1 14 0c0 4.8-7 10-7 10z"/><circle cx="12" cy="11" r="2.5"/></svg>
            <span>Nessuna trasferta</span>
          </li>
          <li>
            <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M9 15h6"/></svg>
            <span>Incarico professionale</span>
          </li>
        </ul>
        <a href="#candidatura" class="btn btn--primary">Vai al modulo</a>
      </div>
      <div class="apertura__figura" aria-hidden="true">
        <img
          src="/docente-lavora-con-noi.webp"
          alt=""
          width="592"
          height="1000"
          loading="eager"
          decoding="async"
        />
      </div>
    </div>
  </section>

  {/* CHI CERCHIAMO */}
  <section class="section">
    <div class="container">
      <div class="section-head section-head--riga reveal">
        <p class="eyebrow">Chi cerchiamo</p>
        <h2>Quattro cose, e sono tutte</h2>
      </div>
      <ul class="leve">
        {requisiti.map((r, i) => (
          <li class="leva reveal" style={`--d: ${i * 0.06}s`}>
            <h3><Freccia classe="leva__segno" />{r.titolo}</h3>
            <p>{r.testo}</p>
          </li>
        ))}
      </ul>
      <p class="leve-nota reveal">
        Non chiediamo un numero minimo di anni e non chiediamo di aver già
        insegnato: <strong>chiediamo che la materia sia davvero la vostra.</strong>
      </p>
    </div>
  </section>

  {/* LE AREE
       ⛔ Le otto aree arrivano da `catalogo.json` come in ogni altra pagina:
       chi si candida deve trovare gli stessi nomi e gli stessi codici che
       vede in vetrina. Se un giorno un'area cambia nome, questa pagina segue
       da sola. */}
  <section class="section section--tinted">
    <div class="container">
      <div class="section-head section-head--riga reveal">
        <p class="eyebrow">Le materie</p>
        <h2>La vostra è qui dentro?</h2>
      </div>
      <ul class="aree-elenco reveal">
        {aree.map((a) => (
          <li>
            <a href={`/formazione/${a.slug}/`}>
              <span class="aree-elenco__sigla">{a.sigla}</span>
              <span class="aree-elenco__nome">{a.nome}</span>
              <span class="aree-elenco__n">
                {a.corsi.length === 1 ? '1 corso' : `${a.corsi.length} corsi`}
              </span>
              <Freccia />
            </a>
          </li>
        ))}
      </ul>
      <p class="leve-nota reveal">
        Ogni corso ha un codice, da <strong>A1</strong> a <strong>H2</strong>:
        apritene uno, guardate il programma e nel modulo indicate il codice.
        Se la vostra materia sfiora più aree, scriveteci quale trovate più
        vicina e ne parliamo.
      </p>
    </div>
  </section>

  {/* COME FUNZIONA */}
  <section class="section">
    <div class="container">
      <div class="section-head section-head--riga reveal">
        <p class="eyebrow">Come funziona</p>
        <h2>Dalla candidatura all'incarico</h2>
      </div>
      <ol class="passi">
        {passi.map((p, i) => (
          <li class="passo reveal" style={`--d: ${i * 0.08}s`}>
            <span class="passo__n">{p.n}</span>
            <h3>{p.titolo}</h3>
            <p>{p.testo}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* COSA NON È
       ⛔ Fondo scuro come il blocco del compenso di `/consulenza/`, e per lo
       stesso motivo: è la parte che il lettore vuole sapere subito e che
       nascosta in fondo a un paragrafo sembra una cosa che non si vuole dire.
       ⛔ Qui dentro NON entrano cifre. */}
  <section class="section section--dark">
    <div class="container">
      <div class="section-head section-head--riga reveal">
        <p class="eyebrow">Mettiamolo in chiaro</p>
        <h2>Che cosa non è</h2>
        <p>
          Preferiamo dirlo prima che dopo, perché è la ragione per cui una
          candidatura su due non è per noi.
        </p>
      </div>
      <ul class="non-e">
        <li class="reveal">
          <h3>Non è un'assunzione</h3>
          <p>
            Nessun contratto di lavoro subordinato, nessuna sede a cui
            presentarsi, nessun orario. È una collaborazione professionale
            tra la nostra società e la vostra attività.
          </p>
        </li>
        <li class="reveal" style="--d: 0.06s">
          <h3>Non è una prestazione occasionale</h3>
          <p>
            La docenza si fattura, quindi la partita IVA serve. Se non l'avete
            e state valutando di aprirla, scrivetecelo nel modulo: ne parliamo,
            ma non fingiamo che la questione non esista.
          </p>
        </li>
        <li class="reveal" style="--d: 0.12s">
          <h3>Non è un posto fisso mascherato</h3>
          <p>
            Gli incarichi seguono le edizioni dei corsi. Non promettiamo un
            numero di ore all'anno, perché non saremmo in grado di
            mantenerlo: quello che possiamo dirvi è che cosa comprende ogni
            singolo incarico, per iscritto e prima che cominci.
          </p>
        </li>
      </ul>
    </div>
  </section>

  {/* IL MODULO */}
  <section class="section section--tinted" id="candidatura">
    <div class="container">
      <div class="section-head section-head--riga reveal">
        <p class="eyebrow">La candidatura</p>
        <h2>Raccontateci di voi</h2>
        <p>
          Le domande sono poche di proposito: servono a capire se la vostra
          materia incontra i nostri corsi. Il resto lo chiediamo parlando.
        </p>
      </div>

      <form
        class="card modulo reveal"
        action="/api/candidatura"
        method="POST"
      >
        <p class="form-esito form-esito--ok" id="form-ok" hidden>
          Candidatura ricevuta, grazie. La leggiamo e vi facciamo sapere.
        </p>
        <p class="form-esito form-esito--errore" id="form-errore" hidden>
          Ops, qualcosa non ha funzionato. Riprovate tra poco oppure
          scriveteci a
          <a href="mailto:info@mensanaformazione.com">info@mensanaformazione.com</a>.
        </p>

        {/* Honeypot antispam: invisibile agli umani, come su /contatti/. */}
        <input type="text" name="azienda" class="hp-field" tabindex="-1" autocomplete="off" aria-hidden="true" />

        <div class="modulo__coppia">
          <label>
            <span class="eti">Nome e cognome</span>
            <input type="text" name="nome" required autocomplete="name" />
          </label>
          <label>
            <span class="eti">Email</span>
            <input type="email" name="email" required autocomplete="email" />
          </label>
        </div>

        <div class="modulo__coppia">
          <label>
            <span class="eti">Telefono <span class="facolt">(facoltativo)</span></span>
            <input type="tel" name="telefono" autocomplete="tel" />
          </label>
          <label>
            <span class="eti">Città <span class="facolt">(facoltativo)</span></span>
            <input type="text" name="citta" autocomplete="address-level2" />
          </label>
        </div>

        {/* ⛔ LA DOMANDA DI SCREENING. È la prima del modulo dopo i recapiti
             e non è facoltativa: è esattamente quella che mancava
             all'annuncio LinkedIn del 27/08 (voce 78). La terza risposta
             esiste perché un no secco farebbe abbandonare il modulo a chi
             la partita IVA la aprirebbe: meglio saperlo e decidere noi. */}
        <label class="modulo__pieno modulo__screening">
          <span class="eti">Avete partita IVA?</span>
          <select name="partitaiva" required>
            <option value="">Scegli…</option>
            <option>Sì, ho partita IVA</option>
            <option>No, ma sono disposto ad aprirla</option>
            <option>No</option>
          </select>
        </label>

        <div class="modulo__coppia">
          <label>
            <span class="eti">Area del catalogo</span>
            <select name="area" required>
              <option value="">Scegli…</option>
              {aree.map((a) => (
                <option>{a.sigla} · {a.nome}</option>
              ))}
              <option>Più di un'area</option>
              <option>Non saprei, valutate voi</option>
            </select>
          </label>
          <label>
            <span class="eti">Codice del corso <span class="facolt">(facoltativo)</span></span>
            <input type="text" name="codice" placeholder="es. B1, C2" />
          </label>
        </div>

        <div class="modulo__coppia">
          <label>
            <span class="eti">Da quanto esercitate su questa materia</span>
            <select name="esperienza" required>
              <option value="">Scegli…</option>
              <option>Meno di 3 anni</option>
              <option>Da 3 a 5 anni</option>
              <option>Da 6 a 10 anni</option>
              <option>Oltre 10 anni</option>
            </select>
          </label>
          <label>
            <span class="eti">Avete già insegnato?</span>
            <select name="docenza" required>
              <option value="">Scegli…</option>
              <option>Sì, tengo corsi con regolarità</option>
              <option>Qualche volta, non con continuità</option>
              <option>No, sarebbe la prima volta</option>
            </select>
          </label>
        </div>

        <label class="modulo__pieno">
          <span class="eti">Profilo LinkedIn o sito <span class="facolt">(facoltativo)</span></span>
          <input type="url" name="profilo" placeholder="https://" />
        </label>

        <label class="modulo__pieno">
          <span class="eti">Due righe su di voi</span>
          <textarea
            name="messaggio"
            rows="6"
            required
            placeholder="Che cosa fate oggi, su quali materie lavorate e che cosa vorreste insegnare. Se avete già tenuto corsi, dove."
          ></textarea>
        </label>

        {/* ⛔ Il consenso rimanda al paragrafo dedicato dell'informativa, non
             a quello del modulo contatti: la finalità è la selezione, non il
             riscontro a una richiesta commerciale. */}
        <label class="privacy-check modulo__pieno">
          <input type="checkbox" name="privacy" value="si" required />
          <span>
            Ho letto l'<a href="/privacy/#candidature">Informativa Privacy</a>
            e acconsento al trattamento dei miei dati per la valutazione della
            candidatura (art. 13 GDPR).
          </span>
        </label>

        <button type="submit" class="btn btn--primary">Invia la candidatura</button>

        <p class="modulo__nota">
          Preferite scrivere una mail? Va bene lo stesso:
          <a href="mailto:info@mensanaformazione.com">info@mensanaformazione.com</a>,
          indicando materia e partita IVA.
        </p>
      </form>
    </div>
  </section>
</Base>

<script>
  // Esito dell'invio: la funzione /api/candidatura rimanda qui con
  // ?inviato=1 oppure ?errore=1. ⛔ Rimanda QUI e non su /contatti/, che è
  // dove porta il modulo dell'altra pagina.
  const params = new URLSearchParams(window.location.search);
  if (params.has('inviato')) {
    document.getElementById('form-ok')?.removeAttribute('hidden');
  } else if (params.has('errore')) {
    document.getElementById('form-errore')?.removeAttribute('hidden');
  }
  if (params.has('inviato') || params.has('errore')) {
    document.querySelector('.modulo')?.scrollIntoView({ block: 'center' });
    history.replaceState(null, '', window.location.pathname);
  }
</script>

<style>
  /* --- Apertura con la figura ---------------------------------------------
     ⛔ La colonna del testo NON è centrata come su /consulenza/ e
     /su-misura/: lì il titolo è solo, qui divide la riga con la persona. */
  .page-hero--figura {
    background: var(--carta);
    padding-block: clamp(2.5rem, 6vw, 4rem) 0;
    overflow: hidden;
  }
  .page-hero--figura + .section { padding-top: clamp(2.5rem, 5vw, 3.5rem); }
  .apertura {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1.5rem, 4vw, 2.5rem);
    align-items: end;
  }
  @media (min-width: 62rem) {
    .apertura {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
      gap: clamp(2rem, 5vw, 4rem);
    }
  }
  .apertura__testo { padding-bottom: clamp(2rem, 5vw, 3.5rem); }
  .page-hero__sub {
    margin-block: 1.4rem 1.6rem;
    font-size: var(--fs-500);
    color: var(--grigio-700);
    max-width: 36rem;
  }
  .page-hero__sub strong { color: var(--nero); }

  /* I tre fatti: rispondono alle tre domande che uno si fa prima di leggere
     i requisiti (dove si insegna, se si viaggia, che rapporto è). */
  .fatti {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.4rem;
    margin-bottom: 1.8rem;
  }
  .fatti li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--fs-300);
    font-weight: 600;
    color: var(--grigio-700);
  }
  .fatti .ico {
    flex: none;
    width: 1.15rem;
    height: 1.15rem;
    fill: none;
    stroke: var(--rosso);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* --- La figura -----------------------------------------------------------
     ⛔ Il velo rosso dietro alla sagoma è lo stesso accorgimento delle storie
     "ricerca docenti": senza, su fondo crema la figura sembra appoggiata sul
     niente. È un tondo sfumato, non un riquadro, così non taglia le braccia.
     ⛔ La figura si adatta ad ALTEZZA, come nelle storie: adattandola a
     larghezza cambierebbe di statura a seconda di quanto sono aperte le
     braccia. */
  /* ⛔ L'altezza va DICHIARATA, non lasciata a `max-height`: con `height:100%`
     su un contenitore senza altezza definita la percentuale non si risolve e
     l'immagine esce alla sua altezza naturale, 1000 px. Visto sul vivo alla
     prima prova: la figura sfondava sopra e sotto e la testa finiva dietro
     alla barra. */
  .apertura__figura {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: flex-end;
    /* Su schermo stretto la figura non deve mangiarsi mezzo telefono. */
    height: clamp(15rem, 46vw, 19rem);
  }
  @media (min-width: 62rem) {
    .apertura__figura { height: clamp(19rem, 30vw, 27rem); }
  }
  .apertura__figura::before {
    content: '';
    position: absolute;
    inset: auto 0 8%;
    aspect-ratio: 1;
    max-width: 26rem;
    margin-inline: auto;
    border-radius: 50%;
    background: radial-gradient(
      circle at 50% 50%,
      rgba(200, 32, 47, 0.16) 0%,
      rgba(200, 32, 47, 0.06) 45%,
      transparent 70%
    );
  }
  .apertura__figura img {
    position: relative;
    height: 100%;
    width: auto;
    max-width: 100%;
    object-fit: contain;
    object-position: bottom center;
  }

  /* --- Requisiti e materie -------------------------------------------------
     Stesso trattamento delle materie di /consulenza/ e delle leve di
     /su-misura/: elenco tipografico, non schede. Il `subgrid` tiene i filetti
     alla stessa quota anche quando un titolo va a capo. */
  .leve {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1.6rem, 3vw, 2.25rem) clamp(2rem, 5vw, 4rem);
  }
  .leva {
    display: grid;
    grid-row: span 2;
    grid-template-rows: subgrid;
    row-gap: 0;
    align-content: start;
  }
  @media (min-width: 48rem) {
    .leve { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  .leva h3 {
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
    font-size: var(--fs-600);
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--grigio-300);
  }
  .leva :global(.leva__segno) { flex: none; color: var(--rosso); }
  .leva p { margin-top: 0.7rem; color: var(--grigio-700); }

  .leve-nota {
    margin-top: clamp(2rem, 4vw, 2.75rem);
    padding-top: clamp(1.25rem, 3vw, 1.75rem);
    border-top: 1px solid var(--grigio-100);
    max-width: 46rem;
    color: var(--grigio-700);
    font-size: var(--fs-400);
  }
  .leve-nota strong { color: var(--nero); }

  /* --- Le otto aree --------------------------------------------------------
     Righe e non schede: è un indice, serve a mandare al catalogo. */
  .aree-elenco { list-style: none; }
  .aree-elenco li + li { border-top: 1px solid var(--grigio-100); }
  .aree-elenco a {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr) auto auto;
    align-items: center;
    gap: 0.9rem;
    padding: 0.95rem 0.2rem;
    color: var(--nero);
    text-decoration: none;
    transition: color var(--transition), padding-left var(--transition);
  }
  .aree-elenco a:hover { color: var(--rosso); padding-left: 0.6rem; }
  .aree-elenco__sigla {
    font-family: var(--font-titoli);
    font-weight: 900;
    font-size: var(--fs-500);
    color: var(--rosso);
