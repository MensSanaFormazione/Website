---
import Base from '../layouts/Base.astro';
import Freccia from '../components/Freccia.astro';
import { aree, LINKEDIN_URL } from '../data/corsi.js';

const nCorsi = aree.reduce((n, a) => n + a.corsi.length, 0);
---

<Base
  title="Mens Sana Formazione | Corsi Legal & Compliance per imprese | Milano"
  description="22 corsi Legal & Compliance per enti, imprese e professionisti: diritto societario, organismi di controllo, contratti, credito, fisco, compliance. Milano, dal 2017."
>
  <!-- HERO -->
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__testo">
        <p class="eyebrow rise" style="--r: 0">Milano · dal 2017</p>
        <h1 class="rise" style="--r: 1">
          La competenza legale che forma.<br />
          <span class="text-rosso"
            >Il sapere che fa <span class="firma"><span class="flip-mask" id="flip-mask"><span class="flip-pista" id="flip-pista"><span class="flip-word" id="flip-a">decidere.</span><span class="flip-word flip-word--sotto" id="flip-b" aria-hidden="true">prevenire.</span></span></span><svg
              class="firma__tratto" id="firma-tratto" viewBox="0 0 200 12" preserveAspectRatio="none"
              aria-hidden="true"
            ><path pathLength="1" d="M2 8.4C34 3.6 74 2.2 116 3.4c28 .8 54 2.6 82 5.2" /></svg></span></span
          >
        </h1>
        <p class="hero__sub rise" style="--r: 2">
          Ventidue corsi <strong>Legal &amp; Compliance</strong> per enti, imprese e
          professionisti: diritto societario, organismi di controllo,
          contrattualistica, credit management, finance e fiscale, compliance.
          Videolezioni con studio guidato ed edizioni aziendali su misura.
        </p>
        <div class="hero__actions rise" style="--r: 3">
          <a href="/formazione/" class="btn btn--primary">Scopri i corsi</a>
          <a href="/su-misura/" class="btn btn--ghost">Un corso su misura</a>
        </div>
        <!-- ⛔ 25/08: qui c'era la riga "22 corsi a catalogo / 8 aree
             tematiche / 9 anni al fianco delle imprese". TOLTA, decisa da
             Nicola dopo averla guardata. Tre motivi, e il terzo e' il piu'
             grave: (a) due numeri su tre erano un doppione di cose scritte
             nella STESSA schermata, il paragrafo qui sopra apre con
             "Ventidue corsi" e la pila a destra elenca le otto aree con i
             conteggi; "9 anni" lo dice gia' l'occhiello "Milano · dal 2017";
             (b) misuravano il nostro listino, non un risultato del cliente,
             cioe' erano il dato meno persuasivo che avevamo; (c) il testo a
             sinistra diventava piu' alto della pila, e sotto "Digitalizzazione
             PA" restavano circa 260 px di vuoto, la stessa meta' destra vuota
             che il 25/08 e' stata tolta da tutte le altre sezioni.
             ⛔ Se un giorno tornano, che siano numeri di risultato (persone
             formate, aziende servite), non di catalogo. -->
      </div>

      <!-- La pila: le aree del catalogo disegnate come dorsi di volumi.
           Non e' decorazione, e' la scorciatoia al catalogo. -->
      <div class="hero__pila">
        <p class="pila__eti rise" style="--r: 2">Il catalogo, per aree</p>
        <ul class="pila">
          {aree.map((area, i) => (
            <li class="pila__voce" style={`--i: ${i}`}>
              <a href={`/formazione/${area.slug}/`}>
                <span class="pila__sigla">{area.sigla}</span>
                <span class="pila__nome">{area.nome}</span>
                <span class="pila__n">{area.corsi.length}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- I DUE MODI DI LAVORARE INSIEME -->
  <section class="section">
    <div class="container">
      <div class="section-head section-head--riga reveal">
        <p class="eyebrow">Cosa facciamo</p>
        <h2>Due modi di lavorare insieme</h2>
        <p>
          Scegli il percorso che ti riguarda: un corso già pronto, scelto fra
          i 22 del catalogo, oppure un percorso costruito da zero sulle
          esigenze della tua organizzazione.
        </p>
      </div>
      <div class="grid grid--2">
        <a href="/formazione/" class="ramo card reveal spot">
          <span class="badge">Formazione</span>
          <h3>Corsi a catalogo ed edizioni aziendali</h3>
          <p>
            Corsi in videolezione su diritto societario, organismi di controllo,
            contrattualistica, credit management e fisco. Programmi modulabili
            ed edizioni dedicate al tuo team.
          </p>
          <span class="ramo__cta">Esplora il catalogo <Freccia /></span>
        </a>
        <a href="/su-misura/" class="ramo card reveal spot" style="--d: .12s">
          <span class="badge">Su misura</span>
          <h3>Il corso costruito sulla vostra azienda</h3>
          <p>
            Quando il catalogo non basta: partiamo dal problema, scriviamo il
            programma, lavoriamo sui vostri contratti e sulle vostre procedure.
            Durata, taglio e formato li decidete voi.
          </p>
          <span class="ramo__cta">Come funziona <Freccia /></span>
        </a>
      </div>
    </div>
  </section>

  <!-- METODO -->
  <section class="section section--dark">
    <div class="container">
      <div class="section-head section-head--riga reveal">
        <p class="eyebrow">Il metodo</p>
        <h2>Before / During / After</h2>
        <p>
          Lo stesso approccio in tutto ciò che facciamo: capire prima,
          eseguire bene, restare al tuo fianco dopo.
        </p>
      </div>
      <div class="grid grid--3">
        <div class="metodo reveal" style="--d: 0s">
          <span class="metodo__num">01</span>
          <h3>Before · Ascolto</h3>
          <p>
            Analizziamo il tuo contesto e i tuoi obiettivi: nessuna soluzione
            preconfezionata, solo ciò che serve davvero.
          </p>
        </div>
        <div class="metodo reveal" style="--d: .12s">
          <span class="metodo__num">02</span>
          <h3>During · Esecuzione</h3>
          <p>
            Formazione erogata da professionisti che la materia la praticano
            ogni giorno, con materiali aggiornati alla normativa vigente.
          </p>
        </div>
        <div class="metodo reveal" style="--d: .24s">
          <span class="metodo__num">03</span>
          <h3>After · Presenza</h3>
          <p>
            Verifica dei risultati, assistenza continuativa e aggiornamento nel
            tempo. Non consegniamo e spariamo: restiamo.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- VALORI
       ⛔ 25/08: era la quarta sezione di fila fatta allo stesso modo (titolo a
       sinistra e quattro schede bianche col bordo grigio), e le schede avevano
       pure il titolo attaccato al paragrafo. Adesso e' LA fascia rossa del
       sito, l'unica, e l'unica a tutta larghezza: il rosso del marchio si
       prende una superficie invece di comparire solo su bottoni ed etichette,
       e il ritmo della pagina si rompe sul colore e sulla forma insieme.
       ⛔ I quattro testi NON sono stati toccati: cambia il trattamento, non
       quello che diciamo. -->
  <section class="section section--rosso">
    <svg class="filigrana" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M5.77 3.84 L23 12 L1 20.16 Z" />
    </svg>
    <div class="container">
      <div class="section-head section-head--largo reveal">
        <p class="eyebrow">Perché noi</p>
        <h2>Competenza, concretezza,<br />velocità, risultato</h2>
      </div>
      <div class="punti">
        <div class="punto-n reveal">
          <span class="punto-n__n">01</span>
          <h3>La materia la pratichiamo, non solo la insegniamo</h3>
          <p>
            Professionisti con background giuridico e internazionale, abituati a
            parlare la lingua delle imprese, non solo quella dei codici.
          </p>
        </div>
        <div class="punto-n reveal" style="--d: .12s">
          <span class="punto-n__n">02</span>
          <h3>Su misura, sempre</h3>
          <p>
            Ogni corso parte dalle tue esigenze specifiche: durata, taglio e
            casi pratici. Il catalogo è la base, la personalizzazione è la regola.
          </p>
        </div>
        <div class="punto-n reveal" style="--d: .24s">
          <span class="punto-n__n">03</span>
          <h3>Risposte in tempi da impresa</h3>
          <p>
            Chi scrive riceve una risposta vera, con programma e proposta
            economica, non un modulo di ricontatto. Le decisioni aziendali non
            aspettano.
          </p>
        </div>
        <div class="punto-n reveal" style="--d: .36s">
          <span class="punto-n__n">04</span>
          <h3>Aggiornati alla norma di oggi</h3>
          <p>
            I programmi si riscrivono quando cambia la legge, non a fine anno:
            il diritto d'impresa si muove più in fretta dei cataloghi.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- LINKEDIN -->
  <section class="section">
    <div class="container">
      <a
        href={LINKEDIN_URL}
        target="_blank"
        rel="noopener"
        class="linkedin-banner spot reveal"
      >
        <div class="linkedin-banner__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="30" height="30" fill="currentColor"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.55C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.72C24 .77 23.2 0 22.22 0z"/></svg>
        </div>
        <div class="linkedin-banner__text">
          <h2>Il diritto d'impresa, spiegato bene. Su LinkedIn.</h2>
          <p>
            Pillole di compliance, novità normative e anteprime dei nostri corsi:
            seguici e resta aggiornato dove lavori ogni giorno.
          </p>
        </div>
        <span class="btn btn--primary linkedin-banner__cta">Segui Mens Sana Formazione</span>
      </a>
    </div>
  </section>

  <!-- CHIUSURA
       ⛔ 25/08: questa fascia era color panna, e la panna sulla home compariva
       QUI e basta. Un tono che appare una volta sola non sembra un sistema,
       sembra un errore (segnalato da Nicola). Adesso la home chiude con lo
       stesso blocco scuro che chiude il catalogo e le pagine area: un solo
       gesto di chiusura, riconoscibile ovunque nel sito. -->
  <!-- ⛔ CODA DEL 25/08: questo blocco aveva il testo su meta' riquadro e
       l'altra meta' nera e vuota, quasi il 45% di un blocco alto mezzo
       schermo. Adesso la colonna di destra porta i recapiti veri, che stavano
       solo nel piede: chi e' gia' pronto a chiamare non deve scorrere fino in
       fondo per trovare un numero.
       ⛔ E il pulsante non dice piu' "Scrivici": in tutto il sito l'azione di
       conversione si chiama "Parliamone", come in testata. Sette formule
       diverse per due sole azioni erano il motivo per cui non si capiva qual
       era la cosa da fare. -->
  <section class="section section--dark">
    <div class="container">
      <div class="invito">
        <div class="reveal">
          <div class="section-head">
            <p class="eyebrow">Parliamone</p>
            <h2>Raccontaci cosa vi serve</h2>
            <p>
              Un corso a catalogo o un percorso costruito su di voi. Ti rispondiamo
              entro un giorno lavorativo, con un programma e una proposta scritti.
            </p>
          </div>
          <div class="invito__azione">
            <a href="/contatti/" class="btn btn--light">Parliamone</a>
          </div>
        </div>
        <ul class="invito__recapiti reveal" style="--d: .12s">
          <li>
            <span class="invito__eti">Telefono</span>
            <span class="invito__val"><a href="tel:+390281558505">(+39) 02 8155 8505</a></span>
          </li>
          <li>
            <span class="invito__eti">Cellulare</span>
            <span class="invito__val"><a href="tel:+393519013820">(+39) 351 901 3820</a></span>
          </li>
          <li>
            <span class="invito__eti">Posta</span>
            <span class="invito__val"><a href="mailto:info@mensanaformazione.com">info@mensanaformazione.com</a></span>
          </li>
          <li>
            <span class="invito__eti">Dove siamo</span>
            <span class="invito__nota">Via San Francesco d'Assisi 13, 20122 Milano<br />Lun-Ven 9:00-18:00, Sabato 9:00-12:00</span>
          </li>
        </ul>
      </div>
    </div>
  </section>
</Base>

<script>
  /* La parola del titolo: esce verso l'alto, la nuova entra da sotto dentro
     una mascherina, e il riquadro si allarga insieme a lei. ⛔ Le larghezze si
     misurano una volta sola all'avvio: se cambiassero durante l'animazione la
     riga sotto ballerebbe. */
  /* ⛔ 25/08, QUARTA riscrittura di questo blocco in una mattina, e l'unica
     che toglie la causa invece dei sintomi. Le tre prima erano rimedi: il
     punto staccato di dieci pixel, il punto su una riga da solo, il punto in
     alto mentre la parola saliva ancora. Ogni volta il difetto tornava
     diverso, e il motivo e' che il rullo aveva UN SOLO elemento: la parola
     usciva in alto in 320 ms e solo DOPO la stessa parola veniva rimessa in
     basso e riportata su, quindi per circa 640 ms la riga era vuota o quasi.
     ⛔ Un rullo con un elemento solo non puo' esistere: mentre la vecchia esce
     ci deve gia' essere la nuova che entra. Adesso dentro la mascherina ci
     sono DUE parole, una in vista e una parcheggiata appena sotto il bordo, e
     a scorrere e' la pista che le contiene entrambe. La riga non e' mai vuota
     perche' c'e' sempre almeno una delle due dentro il ritaglio.
     ⛔ Il punto e' testo della parola, non un elemento a se': non c'e' piu'
     niente da tenere sincronizzato. */
  const words = ['decidere', 'prevenire', 'controllare', 'crescere'];
  const mask = document.getElementById('flip-mask');
  const pista = document.getElementById('flip-pista');
  const a = document.getElementById('flip-a');   // quella che si vede
  const b = document.getElementById('flip-b');   // quella parcheggiata sotto
  const tratto = document.getElementById('firma-tratto');

  const DURATA = 420;   // deve combaciare con la transizione di .flip-pista

  let larghezze = [];
  let i = 0;

  /* ⛔ Le larghezze si misurano col carattere VERO: misurate prima che
     Fraunces sia arrivato sarebbero quelle di Georgia, e la mascherina
     uscirebbe piu' larga della parola. Si rimisura anche dopo un
     ridimensionamento, perche' il corpo del titolo e' fluido. */
  const misura = () => {
    if (!a || !mask) return;
    const tenere = a.textContent;
    larghezze = words.map((w) => {
      a.textContent = w + '.';
      return a.getBoundingClientRect().width;
    });
    a.textContent = tenere;
    mask.style.width = larghezze[i] + 'px';
  };

  const traccia = () => tratto && tratto.classList.add('is-tracciata');
  const ritira = () => tratto && tratto.classList.remove('is-tracciata');

  const avvia = () => {
    if (!a || !b || !mask || !pista) return;
    i = 0;
    a.textContent = words[0] + '.';
    misura();
    setTimeout(traccia, 700);

    setInterval(() => {
      const prossimo = (i + 1) % words.length;
      /* La parola nuova si prepara sotto il bordo e la mascherina comincia
         subito ad allargarsi verso la sua misura: le due cose viaggiano
         insieme, se no per un attimo si vedrebbe la parola tagliata. */
      b.textContent = words[prossimo] + '.';
      mask.style.width = larghezze[prossimo] + 'px';
      ritira();
      pista.classList.add('is-scorre');

      setTimeout(() => {
        /* Finito lo scorrimento si rimette tutto al punto di partenza SENZA
           che si veda: si spegne la transizione, si riporta la pista a zero e
           si sposta il testo nuovo nella parola in vista. ⛔ Il
           `getBoundingClientRect` in mezzo non e' decorativo: obbliga il
           browser a fare i conti prima che la transizione torni attiva, se no
           la pista scivolerebbe indietro davanti agli occhi. */
        i = prossimo;
        pista.style.transition = 'none';
        pista.classList.remove('is-scorre');
        a.textContent = words[i] + '.';
        void pista.getBoundingClientRect();
        pista.style.transition = '';
        setTimeout(traccia, 60);
      }, DURATA);
    }, 3000);
  };

  if (a && b && mask && pista && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(avvia).catch(avvia);
    } else {
      avvia();
    }

    /* Si rimisura a finestra ferma, e mai durante uno scorrimento: rimisurare
       a meta' cambio farebbe ballare la riga sotto. */
    let attesa;
    window.addEventListener('resize', () => {
      clearTimeout(attesa);
      attesa = setTimeout(() => {
        if (pista.classList.contains('is-scorre')) return;
        misura();
      }, 200);
    }, { passive: true });
  }
</script>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: var(--carta);
    /* ⛔ 25/08, difetto visto da Nicola e causato da me: qui c'era
       `border-bottom: 1px solid var(--grigio-100)`, e il 25/08 ho aggiunto un
       filetto anche sopra le teste di sezione. Risultato: DUE righe
       orizzontali a 145 px l'una dall'altra con niente in mezzo, cioe' una
       fascia vuota che si legge come un errore di impaginazione.
       Due segni che fanno lo stesso lavoro sono uno di troppo: resta quello
       della testa di sezione, che almeno ha un contenuto attaccato sotto.
       ⛔ E lo spazio si e' stretto: l'apertura chiudeva con 80 px di aria e la
       sezione dopo ne apriva altri 104. */
    padding-block: clamp(3.5rem, 8vw, 6.5rem) clamp(2rem, 4vw, 3rem);
  }
  /* La prima sezione dopo l'apertura non ha bisogno dello spazio pieno: sopra
     di lei c'e' gia' l'aria di chiusura dell'apertura. */
  .hero + .section { padding-top: clamp(2.5rem, 5vw, 3.5rem); }
  /* ⛔ Le due macchie sfocate che vagavano sono state tolte il 24/08: non
     dicevano niente e occupavano proprio lo spazio dove ora c'e' la pila. */

  .hero__inner {
    position: relative;
    display: grid;
    gap: clamp(2.5rem, 6vw, 4rem);
    /* ⛔ Era `center`: la pila galleggiava a mezz'aria e lasciava il vuoto
       sotto l'ultima area. Tolti i numeri, le due colonne hanno quasi la
       stessa altezza e allineate in cima chiudono insieme. */
    align-items: start;
  }
  @media (min-width: 62rem) {
    /* ⛔ 25/08: la pila stava troppo addosso al titolo. Lo spazio fra le due
       colonne e' cresciuto e la pila si e' spostata a destra, dove c'era
       spazio libero. */
    .hero__inner {
      grid-template-columns: minmax(0, 1fr) minmax(22rem, 30rem);
      gap: clamp(3rem, 8vw, 7rem);
    }
  }
  .hero__testo { max-width: 42rem; }
  /* La firma: il tratto rosso si ridisegna a ogni parola nuova. */
  /* ⛔ 25/08, e questa e' la terza correzione dello STESSO punto in una
     mattina: le prime due erano rimedi ai sintomi, questa toglie la causa.
     Il punto era un elemento a se', fuori dalla mascherina, con una sua
     animazione di opacita'. Da li' sono usciti tre difetti in fila, tutti
     trovati da Nicola guardando: il punto staccato di dieci pixel (le
     larghezze misurate prima che arrivasse Fraunces), il punto SU UNA RIGA DA
     SOLO sotto "controllare" (fra due elementi in linea il browser puo'
     sempre andare a capo), e il punto in alto a destra mentre la parola
     saliva ancora dal basso (la mascherina prende subito la larghezza nuova,
     il punto la segue, la parola no).
     ⛔ La lezione: due pezzi che devono muoversi insieme non si sincronizzano,
     si fondono. Adesso il punto E' la parola: `decidere.` sta tutto dentro la
     mascherina, esce ed entra come una cosa sola, e non c'e' piu' niente da
     tenere allineato.
     ⚠️ Il prezzo, voluto: il tratto rosso adesso passa anche sotto il punto.
     Su una sottolineatura fatta a pennello e' il gesto naturale. Se non
     convince, si accorcia il tratto qui sotto e basta. */
  .firma { position: relative; display: inline-block; }
  .firma__tratto {
    position: absolute;
    left: -2%;
    bottom: -0.16em;
    width: 104%;
    height: 0.34em;
    overflow: visible;
    fill: none;
    stroke: var(--rosso);
    stroke-width: 6;
    stroke-linecap: round;
    opacity: 0.85;
    /* ⛔ 25/08, difetto trovato guardando il sito vivo: la lunghezza del
       tratteggio era fissa a 210 unita', ma il tracciato viene STIRATO in
       orizzontale (`preserveAspectRatio="none"`) e la sua lunghezza vera
       cambia con la larghezza della parola. Su "controllare" la linea non
       arrivava in fondo, su "crescere" si chiudeva prima e sbordava.
       Con `pathLength="1"` sul tracciato la lunghezza vale 1 qualunque sia la
       parola, e il tratteggio e' sempre esatto. */
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }
  /* La linea si nasconde SOLO se il JavaScript gira: senza, resta disegnata
     invece di sparire per sempre. */
  /* ⛔ 25/08: ritirandosi il tratto lasciava UN PALLINO ROSSO a mezz'aria, e
     con la riga della parola vuota sembrava un puntino sospeso sul niente.
     Non era un difetto di tempi: `stroke-linecap: round` disegna un cerchio
     grande quanto lo spessore ANCHE quando la lunghezza visibile e' zero.
     Rimedio: il tratto sfuma nell'ultima parte del ritiro, cosi' il cerchio
     finale non si vede mai; e quando si ridisegna l'opacita' torna piena
     all'istante, quindi l'effetto del pennello che traccia resta intatto. */
  html.con-js .firma__tratto {
    stroke-dashoffset: 1;
    opacity: 0;
    transition: stroke-dashoffset 0.26s ease-in, opacity 0.16s ease-in 0.1s;
  }
  /* Tracciata: parte da sinistra e arriva sotto l'ultima lettera. Si ritira
     piu' in fretta di quanto si disegni, come un gesto vero. */
