---
import Base from '../layouts/Base.astro';
import {aree,numeroCorsi,areeInLettere,consulenze,corsi} from '../data/corsi.js';
// Opinioni lette sulla scheda pubblica Emagister il 25/10/2026: 222 su 18 corsi, tutti 5,0 tranne D3 a 4,9.
const EMAGISTER_URL = 'https://www.emagister.it/corsi_mens_sana_formazione_srl-cen-104514.htm';
const corsoUrl = (cod) => { const c = corsi.find((x) => x.cod === cod); return c ? `/corsi/${c.slug}/` : '/formazione/'; };
const opinioni = [
  { cod: 'C3', nome: 'Contratti pubblici', n: 23, voto: '5,0' },
  { cod: 'C1', nome: 'Contratti nazionali d’impresa', n: 21, voto: '5,0' },
  { cod: 'F1', nome: 'GDPR e Data Protection Officer', n: 18, voto: '5,0' },
  { cod: 'D1', nome: 'Recupero dei crediti', n: 17, voto: '5,0' },
  { cod: 'D3', nome: 'Gestione del credito commerciale', n: 16, voto: '4,9' },
  { cod: 'E4', nome: 'Project management', n: 15, voto: '5,0' },
];
---
<Base title="Mens Sana Formazione | Corsi Legal & Compliance per imprese | Milano" description="Formazione Legal & Compliance per enti, imprese e professionisti. 24 corsi, nove aree e percorsi aziendali su misura. Milano, dal 2017.">

    <section class="hero wrap" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow entrance"><span class="red-dot"></span> FORMAZIONE LEGAL &amp; COMPLIANCE</p>
        <h1 id="hero-title" class="entrance" aria-label="La competenza legale che forma. Il sapere che fa decidere."><span class="title-row" style="--line:0"><span>La competenza</span></span><span class="title-row" style="--line:1"><span>legale che forma.</span></span><span class="hero-serif"><span class="title-row" style="--line:2"><span>Il sapere che</span></span><span class="title-row" style="--line:3"><span>fa <span class="word-mark">decidere.<svg viewBox="0 0 380 16" aria-hidden="true"><path d="M3 12Q185 0 375 9"/></svg></span></span></span></span></h1>
        <p class="hero-description entrance">Per enti, imprese e professionisti.<br>Videolezioni con studio guidato ed edizioni aziendali su misura, per portare il sapere nel lavoro di ogni giorno.</p>
        <div class="hero-actions entrance">
          <a href="/formazione/" class="button button-red">Scopri i corsi <svg aria-hidden="true" class="icon"><use href="#arrow"/></svg></a>
          <a href="/su-misura/" class="text-link">Un corso su misura <svg aria-hidden="true" class="icon"><use href="#diagonal"/></svg></a>
        </div>
      </div>
      <div class="hero-visual hero-static entrance">
        <div class="hero-photo">
          <img src="/assets/hero-libro-v2.jpg" alt="Scultura di un libro aperto: copertina rossa e pagine di carta illuminate dalla luce naturale." width="1122" height="1402" fetchpriority="high">

        </div>
        <div class="visual-bottomline"><span class="hero-photo-caption">Il sapere apre prospettive.</span></div>
      </div>
      <div class="hero-foot"><span><span class="location-dot" aria-hidden="true"></span> Milano, dal 2017</span><span class="hero-foot-note">CONOSCERE. APPLICARE. CRESCERE.</span></div>
    </section>

    <section class="section wrap" id="formazione" aria-labelledby="formazione-title">
      <div class="section-heading reveal"><p class="eyebrow section-label"><span>01 /</span> COSA FACCIAMO</p><div><h2 id="formazione-title">Due modi di<br><em>lavorare insieme.</em></h2><p class="section-intro">Scegli il percorso che ti riguarda: un corso già pronto, scelto fra i {numeroCorsi} del catalogo, oppure un percorso costruito da zero sulle esigenze della tua organizzazione.</p></div></div>
      <div class="services">
        <a class="service service-catalog reveal" data-depth href="/formazione/">
          <div class="service-top"><span class="eyebrow">IL CATALOGO</span><span class="round-arrow"><svg aria-hidden="true" class="icon"><use href="#diagonal"/></svg></span></div>
          <div class="service-photo depth-surface"><img src="/assets/catalogo-v2.jpg" alt="Volumi rilegati in tessuto, disposti su gradini di pietra chiara." width="1536" height="1024" loading="lazy"><span class="photo-light" aria-hidden="true"></span></div>
          <div class="service-copy"><h3>Corsi a catalogo<br>ed edizioni aziendali.</h3><p>Corsi in videolezione su diritto societario, organismi di controllo, contrattualistica, credit management e fisco. Programmi modulabili ed edizioni dedicate al tuo team.</p><span class="service-link">Esplora il catalogo <svg aria-hidden="true" class="icon"><use href="#arrow"/></svg></span></div>
        </a>
        <a class="service service-custom reveal" data-depth href="/su-misura/">
          <div class="service-top"><span class="eyebrow">SU MISURA</span><span class="round-arrow"><svg aria-hidden="true" class="icon"><use href="#diagonal"/></svg></span></div>
          <div class="service-photo depth-surface"><img src="/assets/su-misura-v2.jpg" alt="Composizione su misura di elementi in travertino, vetro e metallo rosso." width="1536" height="1024" loading="lazy"><span class="photo-light" aria-hidden="true"></span></div>
          <div class="service-copy"><h3>Il corso costruito<br>sulla vostra azienda.</h3><p>Quando il catalogo non basta: partiamo dal problema, scriviamo il programma, lavoriamo sui vostri contratti e sulle vostre procedure. Durata, taglio e formato li decidete voi.</p><span class="service-link">Come funziona <svg aria-hidden="true" class="icon"><use href="#arrow"/></svg></span></div>
        </a>
      </div>
    </section>

    <section class="catalog-section section wrap" id="aree" aria-labelledby="aree-title">
      <div class="catalog-heading reveal"><div><p class="eyebrow"><span class="red-dot"></span> LE AREE DI COMPETENZA</p><h2 id="aree-title">Il tuo prossimo<br><em>punto di partenza.</em></h2></div><div class="catalog-summary"><p><strong>{numeroCorsi} corsi. {areeInLettere.charAt(0).toUpperCase() + areeInLettere.slice(1)} aree.</strong><br>La competenza che serve alla tua organizzazione.</p><a class="text-link" href="/formazione/">Tutto il catalogo <svg aria-hidden="true" class="icon"><use href="#diagonal"/></svg></a></div></div>
      <div class="areas-grid reveal">{aree.filter(a=>a.corsi.length).map(a=>(<a class="area" href={`/formazione/${a.slug}/`}><span class="area-code">{a.sigla}</span><div><h3>{a.nome}</h3><span>{a.corsi.length} {a.corsi.length===1?'corso':'corsi'}</span></div><svg aria-hidden="true" class="icon"><use href="#diagonal"/></svg></a>))}</div><p class="catalog-note">Ogni area può diventare un percorso dedicato alla tua azienda. <a href="/su-misura/">Costruiamolo insieme <svg aria-hidden="true" class="icon"><use href="#diagonal"/></svg></a></p>
    </section>

    <section class="method-section" id="metodo" aria-labelledby="metodo-title">
      <div class="wrap section">
        <div class="section-heading reveal"><p class="eyebrow section-label"><span>02 /</span> IL NOSTRO METODO</p><div><h2 id="metodo-title">Prima. Durante.<br><em>E anche dopo.</em></h2><p class="section-intro">Lo stesso approccio in tutto ciò che facciamo: capire prima, eseguire bene, restare al tuo fianco dopo.</p></div></div>
        <div class="method-grid">
          <article class="method-step reveal"><div class="method-object"><button class="model-stage" type="button" data-model="0" aria-label="Muovi il mouse per ruotare i libri. Premi per separarli." aria-pressed="false" disabled><img class="model-fallback" src="/assets/catalogo-v2.jpg" alt="" width="600" height="400" loading="lazy"><span class="model-glint" aria-hidden="true"></span></button></div><div class="step-label"><span>01</span><span>BEFORE</span></div><h3>Ascolto.</h3><p>Analizziamo il tuo contesto e i tuoi obiettivi: nessuna soluzione preconfezionata, solo ciò che serve davvero.</p></article>
          <article class="method-step reveal"><div class="method-object"><button class="model-stage" type="button" data-model="1" aria-label="Muovi il mouse per ruotare il libro. Premi per aprire le pagine." aria-pressed="false" disabled><img class="model-fallback" src="/assets/hero-libro-v2.jpg" alt="" width="600" height="400" loading="lazy"><span class="model-glint" aria-hidden="true"></span></button></div><div class="step-label"><span>02</span><span>DURING</span></div><h3>Esecuzione.</h3><p>Formazione erogata da professionisti che la materia la praticano ogni giorno, con materiali aggiornati alla normativa vigente.</p></article>
          <article class="method-step reveal"><div class="method-object"><button class="model-stage" type="button" data-model="2" aria-label="Muovi il mouse per ruotare i volumi. Premi per esploderne la composizione." aria-pressed="false" disabled><img class="model-fallback" src="/assets/catalogo-v2.jpg" alt="" width="600" height="400" loading="lazy"><span class="model-glint" aria-hidden="true"></span></button></div><div class="step-label"><span>03</span><span>AFTER</span></div><h3>Presenza.</h3><p>Verifica dei risultati, assistenza continuativa e aggiornamento nel tempo. Non consegniamo e spariamo: restiamo.</p></article>
        </div>
      </div>
    </section>

    <section class="why-section section wrap" aria-labelledby="why-title">
      <div class="why-heading reveal"><p class="eyebrow section-label"><span>03 /</span> PERCHÉ MENS SANA</p><h2 id="why-title">Competenza.<br>Concretezza.<br>Velocità.<br><em>Risultato.</em></h2><div class="material-detail" data-depth><div class="depth-surface"><img src="/assets/su-misura-v2.jpg" alt="Dettaglio di materiali e incastri della composizione architettonica." width="1536" height="1024" loading="lazy"></div><span>Ogni dettaglio, un’esigenza precisa.</span></div></div>
      <div class="values reveal">
        <details open><summary><span class="value-number">01</span><h3>La materia la pratichiamo,<br>non solo la insegniamo.</h3><span class="plus" aria-hidden="true"></span></summary><p>Professionisti con background giuridico e internazionale, abituati a parlare la lingua delle imprese, non solo quella dei codici.</p></details>
        <details><summary><span class="value-number">02</span><h3>Su misura, sempre.</h3><span class="plus" aria-hidden="true"></span></summary><p>Ogni corso parte dalle tue esigenze specifiche: durata, taglio e casi pratici. Il catalogo è la base, la personalizzazione è la regola.</p></details>
        <details><summary><span class="value-number">03</span><h3>Risposte in tempi<br>da impresa.</h3><span class="plus" aria-hidden="true"></span></summary><p>Chi scrive riceve una risposta vera, con programma e proposta economica, non un modulo di ricontatto. Le decisioni aziendali non aspettano.</p></details>
        <details><summary><span class="value-number">04</span><h3>Aggiornati alla norma<br>di oggi.</h3><span class="plus" aria-hidden="true"></span></summary><p>I programmi si riscrivono quando cambia la legge, non a fine anno: il diritto d’impresa si muove più in fretta dei cataloghi.</p></details>
      </div>
    </section>

    <section class="proof-section section wrap" id="opinioni" aria-labelledby="opinioni-title">
      <div class="proof-main">
        <div class="proof-heading reveal">
          <p class="eyebrow section-label"><span>04 /</span> CHI HA STUDIATO CON NOI</p>
          <h2 id="opinioni-title">Lo dicono<br><em>i partecipanti.</em></h2>
          <div class="proof-score">
            <p class="proof-number"><strong>222</strong><span>opinioni su Emagister</span></p>
            <div class="proof-rating">
              <span class="proof-stars" aria-hidden="true">{[1,2,3,4,5].map(() => (<svg viewBox="0 0 24 24" class="icon"><path d="M12 2.8l2.84 5.76 6.36.92-4.6 4.49 1.08 6.33L12 17.31l-5.68 2.99 1.08-6.33-4.6-4.49 6.36-.92z"/></svg>))}</span>
              <p><strong>5,0 su 5</strong> di media</p>
            </div>
          </div>
          <p class="proof-note">Valutazioni lasciate sul portale Emagister da chi ha frequentato i nostri corsi, su diciotto corsi del catalogo. Dato rilevato a ottobre 2026.</p>
          <a class="text-link" href={EMAGISTER_URL} target="_blank" rel="noopener noreferrer">Leggi le opinioni <svg aria-hidden="true" class="icon"><use href="#diagonal"/></svg><span class="sr-only"> (si apre in una nuova scheda)</span></a>
        </div>
        <div class="proof-list reveal">
          <p class="proof-list-title">I corsi con più opinioni</p>
          <ul>
            {opinioni.map((o) => (
              <li><a href={corsoUrl(o.cod)}><span class="proof-course">{o.nome}</span><span class="proof-count">{o.n} opinioni</span><span class="proof-vote">{o.voto}</span></a></li>
            ))}
          </ul>
        </div>
      </div>
      <div class="partners reveal">
        <p class="eyebrow">PARTNER</p>
        <ul class="partner-logos">
          <li><a href={EMAGISTER_URL} target="_blank" rel="noopener noreferrer"><img src="/assets/partner/emagister.svg" alt="Emagister" width="128" height="38" loading="lazy"><span class="sr-only"> (si apre in una nuova scheda)</span></a></li>
          <li><a href="https://bbfiorielimoni.it/" target="_blank" rel="noopener noreferrer" class="partner-lockup"><img src="/assets/partner/bb-fiori-e-limoni.webp" alt="" width="180" height="180" loading="lazy"><span><b>Fiori e Limoni</b><i>Bed and Breakfast</i></span><span class="sr-only"> (si apre in una nuova scheda)</span></a></li>
          <li><a href="https://bbgottardo.com/" target="_blank" rel="noopener noreferrer"><img src="/assets/partner/bb-gottardo.webp" alt="B&amp;B Gottardo" width="240" height="240" loading="lazy"><span class="sr-only"> (si apre in una nuova scheda)</span></a></li>
        </ul>
      </div>
    </section>

    <section class="contact-section" id="contatti" aria-labelledby="contatti-title">
      <div class="contact-material" aria-hidden="true"><img src="/assets/hero-libro-v2.jpg" alt="" width="1122" height="1402" loading="lazy"></div>
      <div class="wrap contact-inner">
        <div class="contact-copy reveal"><p class="eyebrow">IL PROSSIMO PASSO, INSIEME</p><h2 id="contatti-title">Raccontaci<br><em>cosa vi serve.</em></h2><p>Un corso a catalogo o un percorso costruito su di voi. Ti rispondiamo entro un giorno lavorativo, con un programma e una proposta scritti.</p><a href="/contatti/" class="button button-paper">Parliamone <svg aria-hidden="true" class="icon"><use href="#diagonal"/></svg></a></div>
        <div class="contact-details reveal"><div><span>SCRIVICI</span><a href="mailto:info@mensanaformazione.com">info@mensanaformazione.com <svg aria-hidden="true" class="icon"><use href="#diagonal"/></svg></a></div><div><span>CHIAMACI</span><a href="tel:+390281558505">(+39) 02 8155 8505</a><a class="mobile-number" href="tel:+393519013820">(+39) 351 901 3820</a></div><div><span>INCONTRIAMOCI</span><p>Via San Francesco d’Assisi 13<br>20122 Milano</p></div></div>
      </div>
    </section>

    <section class="community wrap" aria-label="Resta in contatto con Mens Sana">
      <div class="community-block reveal"><p class="eyebrow">SELEZIONE DOCENTI</p><h2>Insegnate quello<br><em>che praticate.</em></h2><p>Cerchiamo professionisti che la materia la esercitano ogni giorno, per le nove aree del catalogo. Incarichi a collaboratori con partita IVA, non posizioni da dipendente.</p><a href="/lavora-con-noi/" class="text-link">Lavora con noi <svg aria-hidden="true" class="icon"><use href="#diagonal"/></svg></a></div>
      <div class="community-block reveal"><p class="eyebrow">CONTINUIAMO A CONDIVIDERE</p><h2>Il diritto d’impresa,<br><em>spiegato bene.</em></h2><p>Pillole di compliance, novità normative e anteprime dei nostri corsi: seguici e resta aggiornato dove lavori ogni giorno.</p><a class="text-link linkedin-link" href="https://www.linkedin.com/company/mens-sana-formazione-srl/" target="_blank" rel="noopener noreferrer">Seguici su LinkedIn <svg aria-hidden="true" class="icon"><use href="#diagonal"/></svg><span class="sr-only"> (si apre in una nuova scheda)</span></a></div>
    </section>
  
</Base>
