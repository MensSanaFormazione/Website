---
// Prezzo nelle schede riassuntive (pagine area, "Altri corsi", indice).
// Se il corso e' in offerta mostra listino barrato, prezzo, bollino e la
// condizione; altrimenti il comportamento di sempre.
import { offerta, mostraPrezzo } from '../data/corsi.js';
interface Props { corso: any; classe?: string; }
const { corso, classe = 'corso__prezzo' } = Astro.props;
const o = offerta(corso.cod);
const fmt = (n) => String(n).replace(/\B(?=(\d{3})+(?!\d))/g, '.');
---
{o ? (
  <div class={`${classe} prezzo-offerta`}>
    <span class="prezzo-offerta__bollino">In offerta -{o.sconto}%</span>
    <span class="prezzo-offerta__cifre"><s>{fmt(o.listino)} €</s> <strong>{fmt(o.prezzo)} €</strong> <small>+ IVA</small></span>
    <span class="prezzo-offerta__nota">Iscrizioni entro il 31 dicembre 2026, fino a esaurimento posti.</span>
  </div>
) : (
  <p class={classe}>
    {mostraPrezzo(corso) ? (<>{fmt(corso.prezzo)} € <small>+ IVA</small></>) : (<small>Quota su richiesta</small>)}
  </p>
)}
